theorem T003 (T : ℝ) (gamma : ℝ) (R : ℝ)  :
    KdVPlan.FourFrequency := by
  classical
  constructor
  · exact @yui_aux_0007 T gamma R
  · let C : ℝ := 24*4*(3/(1-(Real.sqrt 2)⁻¹))
    have hC : 0 < C := by
      have hr := (@yui_aux_0022 T gamma R).1.2
      dsimp [C]
      positivity
    refine ⟨C, hC, ?_⟩
    intro x₁ x₂ x₃ x₄ h₁ h₂ h₃ h₄ A
    let x : Fin 4 → ℤ → ℝ := ![x₁,x₂,x₃,x₄]
    have hx : ∀ i : Fin 4, KdVPlan.NonnegL2 (x i) := by
      intro i
      fin_cases i
      · exact h₁
      · exact h₂
      · exact h₃
      · exact h₄
    let f : (ℤ × ℤ × ℤ) → ℝ := KdVPlan.quadTerm A x₁ x₂ x₃ x₄
    have hnon : ∀ z, 0 ≤ f z := by
      intro z
      dsimp only [f, KdVPlan.quadTerm]
      split_ifs
      · apply div_nonneg
        · exact mul_nonneg (mul_nonneg (mul_nonneg (h₁.2.1 z.1) (h₂.2.1 z.2.1)) (h₃.2.1 z.2.2)) (h₄.2.1 (-z.1-z.2.1-z.2.2))
        · unfold KdVPlan.n3
          positivity
      · exact le_rfl
    have hbound : ∀ F : Finset (ℤ × ℤ × ℤ), (∑ z ∈ F, f z) ≤
        C*KdVPlan.seqN x₁*KdVPlan.seqN x₂*KdVPlan.seqN x₃*KdVPlan.seqN x₄ := by
      intro F
      have h := @yui_aux_0029 T gamma R x hx A F
      simpa [C, x, f, Fin.prod_univ_succ, mul_assoc] using h
    have hs : Summable f := summable_of_sum_le hnon hbound
    refine ⟨hs, hs.tsum_le_of_sum_le hbound, ?_⟩
    change (∑' z, f z) = sSup {r : ℝ | ∃ F : Finset (ℤ × ℤ × ℤ), r = ∑ z ∈ F, f z}
    have hb : BddAbove {r : ℝ | ∃ F : Finset (ℤ × ℤ × ℤ), r = ∑ z ∈ F, f z} := by
      refine ⟨C*KdVPlan.seqN x₁*KdVPlan.seqN x₂*KdVPlan.seqN x₃*KdVPlan.seqN x₄, ?_⟩
      rintro r ⟨F, rfl⟩
      exact hbound F
    apply le_antisymm
    · apply hs.tsum_le_of_sum_le
      intro F
      exact le_csSup hb ⟨F, rfl⟩
    · apply csSup_le
      · exact ⟨0, ∅, by simp⟩
      · rintro r ⟨F, rfl⟩
        exact hs.sum_le_tsum F (fun z hz => hnon z)

namespace Local_T017
theorem yui_aux_0001 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T002 : KdVPlan.CovarianceBounds) (h_T003 : KdVPlan.FourFrequency) : yui_aux_type% "∀ (U A B q s : ℝ), 0 ≤ U → 0 < A → 0 < B → 0 < q → 0 ≤ s → s ≤ 1 → U ≤ A → U / q ≤ B → U / q^s ≤ A^(1-s)*B^s" := by
  intro U A B q s hU hA hB hq hs hs1 hUA hUB
  by_cases h0 : U = 0
  · simp [h0, le_of_lt (mul_pos (Real.rpow_pos_of_pos hA _) (Real.rpow_pos_of_pos hB _))]
  have hUp : 0 < U := lt_of_le_of_ne hU (Ne.symm h0)
  have h := mul_le_mul (Real.rpow_le_rpow hU hUA (sub_nonneg.mpr hs1)) (Real.rpow_le_rpow (div_nonneg hU hq.le) hUB hs) (Real.rpow_nonneg (div_nonneg hU hq.le) _) (Real.rpow_nonneg hA.le _)
  calc
   U / q^s = U^(1-s)*(U/q)^s := by
    rw [Real.div_rpow hU hq.le]
    rw [← mul_div_assoc, ← Real.rpow_add hUp]
    congr 1
    rw [sub_add_cancel, Real.rpow_one]
   _ ≤ A^(1-s)*B^s := h

theorem yui_aux_0002 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T002 : KdVPlan.CovarianceBounds) (h_T003 : KdVPlan.FourFrequency) : yui_aux_type% "∀ A B P : ℝ, 0 ≤ P → min (3*A*P) (3*B*P) = 3*P*min A B" := by
  intro A B P hP
  rcases le_total A B with h | h
  · rw [min_eq_left h, min_eq_left (by nlinarith)]
    ring
  · rw [min_eq_right h, min_eq_right (by nlinarith)]
    ring

theorem yui_aux_0003 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T002 : KdVPlan.CovarianceBounds) (h_T003 : KdVPlan.FourFrequency) : yui_aux_type% "∀ (τ : ℝ) (a b c : ℤ), 0 < τ →\n  KdVPlan.Interaction a b c (-(a+b+c)) → a+b ≠ 0 →\n  let k := a+b+c\n  let E := ‖KdVPlan.eta τ (3*(a:ℝ)*(b:ℝ)*(a+b:ℤ)) (3*(k:ℝ)*(c:ℝ)*(a+b:ℤ))‖\n  E / |(k:ℝ)| ≤ 6 / KdVPlan.n3 a b c (-k) ∧\n  (E / |(k:ℝ)|) / |(a:ℝ)*(b:ℝ)*(c:ℝ)| ≤ 18*τ / KdVPlan.n3 a b c (-k)" := by
  intro τ a b c hτ hi hp
  dsimp only
  let k : ℤ := a+b+c
  have ha : (a:ℝ) ≠ 0 := by exact_mod_cast hi.2.1
  have hb : (b:ℝ) ≠ 0 := by exact_mod_cast hi.2.2.1
  have hc : (c:ℝ) ≠ 0 := by exact_mod_cast hi.2.2.2.1
  have hkz : k ≠ 0 := by
    intro hz
    exact hi.2.2.2.2 (by change -k = 0; rw [hz, neg_zero])
  have hk : (k:ℝ) ≠ 0 := by exact_mod_cast hkz
  have hp' : ((a+b:ℤ):ℝ) ≠ 0 := by exact_mod_cast hp
  let A : ℝ := |(a:ℝ)*(b:ℝ)|
  let B : ℝ := |(c:ℝ)*(k:ℝ)|
  let P : ℝ := |((a+b:ℤ):ℝ)|
  let K : ℝ := |(k:ℝ)|
  let Q : ℝ := |(a:ℝ)*(b:ℝ)*(c:ℝ)|
  let N : ℝ := KdVPlan.n3 a b c (-k)
  let α : ℝ := 3*(a:ℝ)*(b:ℝ)*(a+b:ℤ)
  let β : ℝ := 3*(k:ℝ)*(c:ℝ)*(a+b:ℤ)
  let E : ℝ := ‖KdVPlan.eta τ α β‖
  have hA : 0 < A := abs_pos.mpr (mul_ne_zero ha hb)
  have hB : 0 < B := abs_pos.mpr (mul_ne_zero hc hk)
  have hP : 0 < P := abs_pos.mpr hp'
  have hK : 0 < K := abs_pos.mpr hk
  have hQ : 0 < Q := abs_pos.mpr (mul_ne_zero (mul_ne_zero ha hb) hc)
  have hα : |α| = 3*A*P := by
    dsimp [α, A, P]
    norm_num only [abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 3)]
    ring
  have hβ : |β| = 3*B*P := by
    dsimp [β, B, P]
    norm_num only [abs_mul, abs_of_pos (by norm_num : (0:ℝ) < 3)]
    ring
  have hphase : α*β ≠ 0 := by
    apply mul_ne_zero
    · dsimp [α]; exact mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num) ha) hb) hp'
    · dsimp [β]; exact mul_ne_zero (mul_ne_zero (mul_ne_zero (by norm_num) hk) hc) hp'
  have he := (h_T002 τ α β hτ).2 hphase
  have hr1 : |α/β| = A/B := by
    rw [abs_div, hα, hβ]
    field_simp
  have hr2 : |β/α| = B/A := by
    rw [abs_div, hα, hβ]
    field_simp
  have hsmall : min |α| |β| = 3*P*min A B := by
    rw [hα, hβ]
    exact @yui_aux_0002 T gamma R h_T002 h_T003 A B P hP.le
  have hf := h_T003.1 a b c (-k) hi
  have hf0 : (1/K)*min (A/B) (B/A) ≤ 3/N := by
    simpa [K, A, B, N, Int.cast_neg, abs_neg, mul_neg, abs_mul, mul_comm] using hf.2.1
  have hf1 : P / max A B ≤ 6/N := by
    simpa [P, A, B, N, Int.cast_add, Int.cast_neg, abs_neg, mul_neg, abs_mul, mul_comm] using hf.2.2
  have hprod : K*Q = A*B := by
    dsimp [K, Q, A, B]
    simp only [abs_mul]
    ring
  have he0 : E ≤ 2*min (A/B) (B/A) := by simpa [E, hr1, hr2] using he.1
  have he1 : E ≤ τ*(3*P*min A B) := by simpa [E, hsmall] using he.2
  constructor
  · calc
      E / K ≤ (2*min (A/B) (B/A))/K := div_le_div_of_nonneg_right he0 hK.le
      _ = 2*((1/K)*min (A/B) (B/A)) := by ring
      _ ≤ 2*(3/N) := by linarith
      _ = 6/N := by ring
  · have hm : min A B / (A*B) = 1 / max A B := by
      rcases le_total A B with hab | hba
      · rw [min_eq_left hab, max_eq_right hab]; field_simp
      · rw [min_eq_right hba, max_eq_left hba]; field_simp
    calc
      (E/K)/Q = E/(A*B) := by rw [div_div, hprod]
      _ ≤ (τ*(3*P*min A B))/(A*B) := div_le_div_of_nonneg_right he1 (by positivity)
      _ = 3*τ*(P/max A B) := by
        calc
          _ = 3*τ*P*(min A B/(A*B)) := by ring
          _ = _ := by rw [hm]; ring
      _ ≤ 3*τ*(6/N) := mul_le_mul_of_nonneg_left hf1 (by positivity)
      _ = 18*τ/N := by ring

theorem yui_aux_0004 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T002 : KdVPlan.CovarianceBounds) (h_T003 : KdVPlan.FourFrequency) : yui_aux_type% "∀ (U Q N τ s : ℝ), 0 ≤ U → 0 < Q → 0 < N → 0 < τ →\n  0 ≤ s → s ≤ 1 → U ≤ 6/N → U/Q ≤ 18*τ/N →\n  U/Q^s ≤ 6^(1-s)*18^s*τ^s/N" := by
  intro U Q N τ s hU hQ hN hτ hs hs1 h0 h1
  by_cases hs0 : s = 0
  · simpa [hs0] using h0
  by_cases hsone : s = 1
  · simpa [hsone] using h1
  have hi := @yui_aux_0001 T gamma R h_T002 h_T003 U (6/N) (18*τ/N) Q s hU (by positivity) (by positivity) hQ hs hs1 h0 h1
  calc
   U/Q^s ≤ (6/N)^(1-s)*(18*τ/N)^s := hi
   _ = 6^(1-s)*18^s*τ^s/N := by
     rw [Real.div_rpow (by norm_num : (0:ℝ) ≤ 6) hN.le,
         Real.div_rpow (by positivity : (0:ℝ) ≤ 18*τ) hN.le,
         Real.mul_rpow (by norm_num : (0:ℝ) ≤ 18) hτ.le]
     have hpow : N^(1-s)*N^s = N := by
       rw [← Real.rpow_add hN, sub_add_cancel, Real.rpow_one]
     rw [div_mul_div_comm, hpow]
     ring

end Local_T017
