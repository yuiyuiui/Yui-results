          "A",
          "a"
        ]
      }
    },
    {
      "pointer": "spec.json#/definitions/3",
      "record": {
        "id": "D004",
        "symbol": "dim_H",
        "type": "Hausdorff dimension of a set in an extended metric space, in [0,∞]",
        "definition": "dim_H(A) is the usual Hausdorff dimension, represented by native dimH: sup{a∈[0,∞): h^a(A)=∞}, where the supremum is in [0,∞] and sup∅=0. The nonnegative finite exponents are regarded as elements of [0,∞]. This definition in particular uses the convention dim_H(∅)=0. When the dimension is finite it is identified with its nonnegative real value.",
        "depends_on": [
          "D003"
        ],
        "requires": [],
        "binders": [
          {
            "symbol": "X",
            "type": "extended metric space with its Borel structure"
          },
          {
            "symbol": "A",
            "type": "subset of X"
          }
        ],
        "objects": [
