            "B",
            "Stage",
            "Interp",
            "u0",
            "n",
            "v"
          ],
          "produces": [
            {
              "id": "F001",
              "statement": "For each step, v^(n+1)=f+F_n(t_n+tau)+C_n(t_n+tau)-R2_(n,tau)(f,f,f), for f=S_(-t_n)u^n.",
              "binders": [],
