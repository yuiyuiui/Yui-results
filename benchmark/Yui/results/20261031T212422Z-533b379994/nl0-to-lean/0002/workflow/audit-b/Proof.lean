theorem yui_aux_0001 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ s : ℝ, ∀ f g : KdVPlan.Coeff, KdVPlan.MemH s f → KdVPlan.MemH s g → KdVPlan.MemH s (f+g) ∧ KdVPlan.hn s (f+g) ≤ KdVPlan.hn s f+KdVPlan.hn s g ∧ KdVPlan.MemH s (f-g) ∧ KdVPlan.hn s (f-g) ≤ KdVPlan.hn s f+KdVPlan.hn s g" := by
  intro s f g hf hg
  rcases (h_T013.1 s f).mp hf with ⟨x, rfl⟩
  rcases (h_T013.1 s g).mp hg with ⟨y, rfl⟩
  have ha : KdVPlan.FromLP s x + KdVPlan.FromLP s y = KdVPlan.FromLP s (x+y) := by
    funext k
    simp [KdVPlan.FromLP, mul_add]
  have hs : KdVPlan.FromLP s x - KdVPlan.FromLP s y = KdVPlan.FromLP s (x-y) := by
    funext k
    simp [KdVPlan.FromLP, mul_sub]
  rw [ha, hs]
  refine ⟨(h_T013.1 s _).mpr ⟨x+y,rfl⟩, ?_, (h_T013.1 s _).mpr ⟨x-y,rfl⟩, ?_⟩
  · simpa only [h_T013.2.1] using norm_add_le x y
  · simpa only [h_T013.2.1] using norm_sub_le x y

theorem yui_aux_0002 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ s r : ℝ, ∀ f g : KdVPlan.Coeff, ∀ C : ℝ, 0 ≤ C → KdVPlan.MemH r g →\n (∀ k, KdVPlan.weight s k * ‖f k‖^2 ≤ C^2*(KdVPlan.weight r k * ‖g k‖^2)) → KdVPlan.HB s f (C*KdVPlan.hn r g)" := by
  intro s r f g C hC hg h
  have hw : ∀ s k, 0 ≤ KdVPlan.weight s k := fun s k => Real.rpow_nonneg (by positivity) _
  have hf : KdVPlan.MemH s f := Summable.of_nonneg_of_le (fun k => mul_nonneg (hw s k) (sq_nonneg _)) h (hg.mul_left (C^2))
  refine ⟨hf, ?_⟩
  unfold KdVPlan.hn
  calc
   Real.sqrt (∑' k, KdVPlan.weight s k * ‖f k‖^2) ≤ Real.sqrt (∑' k, C^2*(KdVPlan.weight r k * ‖g k‖^2)) :=
    Real.sqrt_le_sqrt (hf.tsum_le_tsum h (hg.mul_left (C^2)))
   _ = C * Real.sqrt (∑' k, KdVPlan.weight r k * ‖g k‖^2) := by rw [tsum_mul_left, Real.sqrt_mul (sq_nonneg C), Real.sqrt_sq hC]

theorem yui_aux_0003 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ f : KdVPlan.Coeff, (KdVPlan.MemH 0 f ↔ Memℓp f 2) ∧ ∀ h : Memℓp f 2, KdVPlan.hn 0 f = ‖(⟨f,h⟩ : lp (fun _ : ℤ => ℂ) 2)‖" := by
