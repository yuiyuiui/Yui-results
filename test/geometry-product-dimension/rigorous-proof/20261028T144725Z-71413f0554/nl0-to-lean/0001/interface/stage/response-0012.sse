be obtained. Other stages may report SOURCE_UNAVAILABLE for an actual access obstacle. Ordinary unfinished work is not an obstacle report. No mathematical acceptance is generated.","parameters":{"type":"object","properties":{"status":{"type":"string","enum":["SUBSTANTIVE_GAP","SUSPECTED_GAP","SOURCE_UNAVAILABLE","MISSING_SOURCE_STATEMENT","INPUT_CONFLICT"]},"location":{"type":"string"},"explanation":{"type":"string"},"basis":{"type":"string"},"partial_progress":{"type":"string"}},"required":["status","location","explanation","basis","partial_progress"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_draft","description":"Preferred structured-object form of check_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_draft","description":"Preferred structured-object form of submit_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"save_interface_draft","description":"Save incomplete own-stage interface JSON without accepting it or invoking Lean. Later revise via base_candidate.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_interface_draft","description":"Read only own current-stage typed candidates or partial type probes; index lists them. No other sta