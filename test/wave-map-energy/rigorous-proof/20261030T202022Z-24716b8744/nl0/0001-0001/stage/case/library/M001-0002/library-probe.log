@HasDerivAt.mul : ∀ {𝕜 : Type u} [inst : NontriviallyNormedField.{u} 𝕜] {x : 𝕜} {𝔸 : Type u_3} [inst_1 : NormedRing.{u_3} 𝔸]
  [inst_2 : NormedAlgebra.{u, u_3} 𝕜 𝔸] {c d : 𝕜 → 𝔸} {c' d' : 𝔸},
