RESOLVED_NAME:M128:ContinuousOn.comp
RESOLVED_MODULE:M128:Mathlib.Topology.ContinuousOn
BEGIN_SIGNATURE:M128
@ContinuousOn.comp : ∀ {α : Type u_1} {β : Type u_2} {γ : Type u_3} [inst : TopologicalSpace.{u_1} α] [inst_1 : TopologicalSpace.{u_2} β]
  [inst_2 : TopologicalSpace.{u_3} γ] {f : α → β} {s : Set.{u_1} α} {g : β → γ} {t : Set.{u_2} β},
  ContinuousOn.{u_2, u_3} g t →
    ContinuousOn.{u_1, u_2} f s →
      Set.MapsTo.{u_1, u_2} f s t → ContinuousOn.{u_1, u_3} (Function.comp.{u_1 + 1, u_2 + 1, u_3 + 1} g f) s
BEGIN_AXIOMS:M128
'ContinuousOn.comp' depends on axioms: [propext, Quot.sound.{u}]
END_SOURCE:M128
