theorem yui_aux_0001 (T : ℝ) (gamma : ℝ) (R : ℝ) : yui_aux_type% "∀ (s : ℝ) (k : ℤ), 0 < KdVPlan.weight s k ∧ KdVPlan.weight (-s/2) k * KdVPlan.weight (s/2) k = 1 ∧ KdVPlan.weight s k * (KdVPlan.weight (-s/2) k)^2 = 1 ∧ (KdVPlan.weight (s/2) k)^2 = KdVPlan.weight s k" := by
  intro s k
  have hb : 0 < 1 + (k : ℝ)^2 := by positivity
  have hm : ∀ a b : ℝ, KdVPlan.weight a k * KdVPlan.weight b k = KdVPlan.weight (a+b) k := by
    intro a b
    exact (Real.rpow_add hb a b).symm
  have hs : ∀ a : ℝ, (KdVPlan.weight a k)^2 = KdVPlan.weight (a+a) k := by
    intro a
    simpa only [pow_two] using hm a a
  refine ⟨Real.rpow_pos_of_pos hb _, ?_, ?_, ?_⟩
  · rw [hm]
    have : -s/2 + s/2 = 0 := by ring
    rw [this]
    simp [KdVPlan.weight]
  · rw [hs, hm]
    have : s + (-s/2 + -s/2) = 0 := by ring
    rw [this]
    simp [KdVPlan.weight]
  · rw [hs]
    congr 1
    ring

theorem yui_aux_0002 (T : ℝ) (gamma : ℝ) (R : ℝ) : yui_aux_type% "∀ (s : ℝ) (f : KdVPlan.Coeff) (k : ℤ), ‖(KdVPlan.weight (s/2) k : ℂ) * f k‖^2 = KdVPlan.weight s k * ‖f k‖^2 ∧ KdVPlan.weight s k * ‖(KdVPlan.weight (-s/2) k : ℂ) * f k‖^2 = ‖f k‖^2 ∧ (KdVPlan.weight (-s/2) k : ℂ) * ((KdVPlan.weight (s/2) k : ℂ) * f k) = f k" := by
  intro s f k
  have hw := yui_aux_0001 T gamma R s k
  have hn := (yui_aux_0001 T gamma R (-s) k).1.le
  have hp : 0 ≤ KdVPlan.weight (-s/2) k := (yui_aux_0001 T gamma R (-s/2) k).1.le
  have hp' : 0 ≤ KdVPlan.weight (s/2) k := (yui_aux_0001 T gamma R (s/2) k).1.le
  refine ⟨?_, ?_, ?_⟩
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hp', mul_pow, hw.2.2.2]
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hp, mul_pow, ← mul_assoc, hw.2.2.1, one_mul]
  · rw [← mul_assoc, ← Complex.ofReal_mul, hw.2.1]
    simp

theorem yui_aux_0003 (T : ℝ) (gamma : ℝ) (R : ℝ) : yui_aux_type% "∀ (s : ℝ) (x : lp (fun _ : ℤ => ℂ) 2), KdVPlan.MemH s (KdVPlan.FromLP s x) ∧ KdVPlan.hn s (KdVPlan.FromLP s x) = ‖x‖" := by
  intro s x
  have hx : Summable (fun k : ℤ => ‖x k‖^2) := by
    simpa using (lp.memℓp x).summable (by norm_num : 0 < (2 : ℝ≥0∞).toReal)
  have he : (fun k => KdVPlan.weight s k * ‖KdVPlan.FromLP s x k‖^2) = (fun k => ‖x k‖^2) := by
    funext k
    exact (yui_aux_0002 T gamma R s x k).2.1
  refine ⟨?_, ?_⟩
  · unfold KdVPlan.MemH
    rw [he]
    exact hx
  · unfold KdVPlan.hn
    rw [he, lp.norm_eq_tsum_rpow (by norm_num : 0 < (2 : ℝ≥0∞).toReal)]
    simp [Real.sqrt_eq_rpow]

theorem yui_aux_0004 (T : ℝ) (gamma : ℝ) (R : ℝ) : yui_aux_type% "∀ (s : ℝ) (f : KdVPlan.Coeff), KdVPlan.MemH s f ↔ ∃ x : lp (fun _ : ℤ => ℂ) 2, f = KdVPlan.FromLP s x" := by
  intro s f
  constructor
  · intro hf
    have hx : Memℓp (fun k : ℤ => (KdVPlan.weight (s/2) k : ℂ) * f k) 2 := by
      apply memℓp_gen
      have he : (fun k : ℤ => ‖(KdVPlan.weight (s/2) k : ℂ)*f k‖ ^ (2 : ℝ≥0∞).toReal) =
          (fun k => KdVPlan.weight s k * ‖f k‖^2) := by
        funext k
        simpa using (yui_aux_0002 T gamma R s f k).1
      rw [he]
      exact hf
    refine ⟨⟨_, hx⟩, ?_⟩
    funext k
    exact ((yui_aux_0002 T gamma R s f k).2.2).symm
  · rintro ⟨x, rfl⟩
    exact (yui_aux_0003 T gamma R s x).1

theorem yui_aux_0005 (T : ℝ) (gamma : ℝ) (R : ℝ) : yui_aux_type% "∀ (s : ℝ) (x y : lp (fun _ : ℤ => ℂ) 2), KdVPlan.FromLP s (x-y) = KdVPlan.FromLP s x-KdVPlan.FromLP s y" := by
  intro s x y
  funext k
  change (KdVPlan.weight (-s/2) k : ℂ)*(x k-y k) =
    (KdVPlan.weight (-s/2) k : ℂ)*x k-(KdVPlan.weight (-s/2) k : ℂ)*y k
  ring

theorem yui_aux_0006 (T : ℝ) (gamma : ℝ) (R : ℝ) : yui_aux_type% "∀ (q r : ℝ) (f : KdVPlan.Coeff), q ≤ r → KdVPlan.MemH r f → KdVPlan.HB q f (KdVPlan.hn r f)" := by
  intro q r f hqr hf
  have hn : ∀ s k, 0 ≤ KdVPlan.weight s k * ‖f k‖^2 := by
    intro s k
    exact mul_nonneg (yui_aux_0001 T gamma R s k).1.le (sq_nonneg _)
  have hle : ∀ k, KdVPlan.weight q k * ‖f k‖^2 ≤ KdVPlan.weight r k * ‖f k‖^2 := by
    intro k
    apply mul_le_mul_of_nonneg_right _ (sq_nonneg _)
    exact Real.rpow_le_rpow_of_exponent_le (by nlinarith [sq_nonneg (k : ℝ)]) hqr
  have hq : KdVPlan.MemH q f := Summable.of_nonneg_of_le (hn q) hle hf
  refine ⟨hq, Real.sqrt_le_sqrt ?_⟩
  exact hq.tsum_le_tsum hle hf

theorem yui_aux_0007 (T : ℝ) (gamma : ℝ) (R : ℝ) : yui_aux_type% "∀ (s : ℝ) (f : KdVPlan.Coeff), KdVPlan.MemH s f → ∀ n : ℕ, KdVPlan.MemH s (KdVPlan.cutoff (n : ℝ) f-f)" := by
  intro s f hf n
  apply Summable.of_nonneg_of_le (f := fun k => KdVPlan.weight s k * ‖f k‖^2)
  · intro k
    exact mul_nonneg (yui_aux_0001 T gamma R s k).1.le (sq_nonneg _)
  · intro k
    by_cases hk : |(k : ℝ)| ≤ (n : ℝ)
    · simp [KdVPlan.cutoff, hk]
      exact mul_nonneg (yui_aux_0001 T gamma R s k).1.le (sq_nonneg _)
    · simp [KdVPlan.cutoff, hk]
  · exact hf

theorem yui_aux_0008 (T : ℝ) (gamma : ℝ) (R : ℝ) : yui_aux_type% "∀ a : ℕ → ℝ, Tendsto a atTop (nhds 0) → Tendsto (fun n => Real.sqrt (a n)) atTop (nhds 0)" := by
  intro a ha
  have hc : Tendsto Real.sqrt (nhds (0 : ℝ)) (nhds (Real.sqrt 0)) :=
    Real.continuous_sqrt.continuousAt.tendsto
  simpa only [Function.comp_def, Real.sqrt_zero] using hc.comp ha

theorem yui_aux_0009 (T : ℝ) (gamma : ℝ) (R : ℝ) : yui_aux_type% "∀ (s : ℝ) (f : KdVPlan.Coeff), KdVPlan.MemH s f → KdVPlan.SeqConv s (fun n : ℕ => KdVPlan.cutoff (n : ℝ) f) f" := by
  intro s f hf
  have hnon : ∀ k, 0 ≤ KdVPlan.weight s k * ‖f k‖^2 := by
    intro k
    exact mul_nonneg (yui_aux_0001 T gamma R s k).1.le (sq_nonneg _)
  let A : ℕ → ℤ → ℝ := fun n k => KdVPlan.weight s k * ‖(KdVPlan.cutoff (n : ℝ) f-f) k‖^2
  have he : ∀ n k, A n k = if |(k : ℝ)| ≤ (n : ℝ) then 0 else KdVPlan.weight s k * ‖f k‖^2 := by
    intro n k
    dsimp [A, KdVPlan.cutoff]
    split_ifs <;> simp_all
  have hAn : ∀ n k, 0 ≤ A n k := by
    intro n k
    rw [he]
    split_ifs
    · exact le_rfl
    · exact hnon k
  have hAle : ∀ n k, A n k ≤ KdVPlan.weight s k * ‖f k‖^2 := by
    intro n k
    rw [he]
    split_ifs
    · exact hnon k
    · exact le_rfl
  have hmem := yui_aux_0007 T gamma R s f hf
  have hpoint : ∀ k, Tendsto (fun n => A n k) atTop (nhds 0) := by
    intro k
    obtain ⟨m, hm⟩ := exists_nat_ge |(k : ℝ)|
    apply tendsto_const_nhds.congr'
    filter_upwards [eventually_ge_atTop m] with n hn
    rw [he, if_pos (hm.trans (by exact_mod_cast hn))]
  have ht : Tendsto (fun n => ∑' k, A n k) atTop (nhds 0) := by
    simpa using tendsto_tsum_of_dominated_convergence hf hpoint
      (Filter.Eventually.of_forall (fun n k => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hAn n k)]
        exact hAle n k))
  have hnorm : Tendsto (fun n : ℕ => KdVPlan.hn s (KdVPlan.cutoff (n : ℝ) f-f)) atTop (nhds 0) := by
    exact yui_aux_0008 T gamma R (fun n => ∑' k, A n k) ht
  refine ⟨hf, ?_⟩
  intro ε hε
  obtain ⟨m, hm⟩ := eventually_atTop.1 (hnorm.eventually (gt_mem_nhds hε))
  exact ⟨m, fun n hn => ⟨hmem n, (hm n hn).le⟩⟩

theorem yui_aux_0010 (T : ℝ) (gamma : ℝ) (R : ℝ) : yui_aux_type% "∀ (s : ℝ) (f : ℕ → KdVPlan.Coeff), (∀ n, KdVPlan.MemH s (f n)) → (∀ ε > 0, ∃ m : ℕ, ∀ n ≥ m, ∀ j ≥ m, KdVPlan.HB s (f n-f j) ε) → ∃ g, KdVPlan.SeqConv s f g" := by
  classical
  intro s f hf hc
  choose x hx using fun n => (yui_aux_0004 T gamma R s (f n)).1 (hf n)
  have hd : ∀ n j, dist (x n) (x j) = KdVPlan.hn s (f n-f j) := by
    intro n j
    rw [dist_eq_norm, ← (yui_aux_0003 T gamma R s (x n-x j)).2,
      yui_aux_0005 T gamma R, ← hx n, ← hx j]
  have hcx : CauchySeq x := by
    apply Metric.cauchySeq_iff.2
    intro ε hε
    obtain ⟨m, hm⟩ := hc (ε/2) (by positivity)
    refine ⟨m, ?_⟩
    intro n hn j hj
    rw [hd]
    exact lt_of_le_of_lt (hm n hn j hj).2 (by linarith)
  obtain ⟨y, hy⟩ := cauchySeq_tendsto_of_complete hcx
  refine ⟨KdVPlan.FromLP s y, (yui_aux_0003 T gamma R s y).1, ?_⟩
  intro ε hε
  obtain ⟨m, hm⟩ := eventually_atTop.1 ((Metric.tendsto_nhds.1 hy) ε hε)
  refine ⟨m, ?_⟩
  intro n hn
  have he : f n-KdVPlan.FromLP s y = KdVPlan.FromLP s (x n-y) := by
    rw [yui_aux_0005 T gamma R, ← hx n]
  rw [he]
  refine ⟨(yui_aux_0003 T gamma R s (x n-y)).1, ?_⟩
  rw [(yui_aux_0003 T gamma R s (x n-y)).2]
  exact (by simpa only [dist_eq_norm] using hm n hn : ‖x n-y‖ < ε).le

