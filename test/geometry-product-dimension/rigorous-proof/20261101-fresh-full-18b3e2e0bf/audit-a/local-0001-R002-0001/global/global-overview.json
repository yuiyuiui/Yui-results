    {
      "pointer": "spec.json#/definitions/7",
      "record": {
        "id": "D008",
        "symbol": "λ",
        "type": "Lebesgue measure on ℝ and nonnegative integral notation",
        "definition": "λ is Lebesgue measure on ℝ with its Borel measurable structure (or its completion). For a measurable set B, |B|=λ(B). Integrals of nonnegative functions and series take values in [0,∞]; ∫_I means integration against the restriction λ|I. For a set J, 1_J is its indicator, taking values 0 and 1. A countable sum of nonnegative terms is the supremum of its finite partial sums.",
        "depends_on": [
