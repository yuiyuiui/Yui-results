@IsCompact.exists_bound_of_continuousOn : ∀ {α : Type u_1} {E : Type u_2} [inst : SeminormedAddGroup.{u_2} E] [inst_1 : TopologicalSpace.{u_1} α]
  {s : Set.{u_1} α},
  IsCompact.{u_1} s →
    ∀ {f : α → E},
      ContinuousOn.{u_1, u_2} f s → ∃ C, ∀ (x : α), Membership.mem.{u_1, u_1} s x → LE.le.{0} (norm.{u_2} (f x)) C
