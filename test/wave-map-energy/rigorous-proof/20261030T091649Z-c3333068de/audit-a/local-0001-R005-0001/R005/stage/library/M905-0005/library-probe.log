BEGIN_SIGNATURE:M905
@DifferentiableAt.derivWithin : ∀ {𝕜 : Type u} [inst : NontriviallyNormedField.{u} 𝕜] {F : Type v} [inst_1 : NormedAddCommGroup.{v} F]
  [inst_2 : NormedSpace.{u, v} 𝕜 F] {f : 𝕜 → F} {x : 𝕜} {s : Set.{u} 𝕜},
  DifferentiableAt.{u, u, v} 𝕜 f x →
    UniqueDiffWithinAt.{u, u} 𝕜 s x → Eq.{v + 1} (derivWithin.{u, v} f s x) (deriv.{u, v} f x)
