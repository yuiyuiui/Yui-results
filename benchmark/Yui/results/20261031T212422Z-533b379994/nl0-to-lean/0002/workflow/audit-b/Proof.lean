theorem yui_aux_0018 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "(∀ s t : ℝ, ∀ f : KdVPlan.Coeff, KdVPlan.MemH s f → KdVPlan.MemH s (KdVPlan.S t f) ∧ KdVPlan.hn s (KdVPlan.S t f) = KdVPlan.hn s f ∧ KdVPlan.HB s (KdVPlan.P f) (KdVPlan.hn s f)) ∧\n(∀ s N : ℝ, ∀ f : KdVPlan.Coeff, KdVPlan.MemH s f → KdVPlan.HB s (KdVPlan.cutoff N f) (KdVPlan.hn s f)) ∧\n(∀ f g : KdVPlan.Coeff, ∀ t : ℝ, KdVPlan.S t (f-g) = KdVPlan.S t f-KdVPlan.S t g ∧ KdVPlan.invD (f-g) = KdVPlan.invD f-KdVPlan.invD g ∧ KdVPlan.P (f-g) = KdVPlan.P f-KdVPlan.P g ∧ KdVPlan.dx (f-g) = KdVPlan.dx f-KdVPlan.dx g)" := by
