: Module.End ℂ V) (r : ℕ) : Module.End ℂ V := ((r.factorial : ℂ)⁻¹) • x ^ r\\ndef MR (p : ℕ) (M : Submodule ℤ V) : Submodule (R p) V := Submodule.span (R p) (M : Set V)\\ndef embed (p : ℕ) (M : Submodule ℤ V) (m : M) : MR p M := ⟨m, Submodule.subset_span m.property⟩\\ndef J (p : ℕ) (M : Submodule ℤ V) (y : Module.End ℂ V) (v : V) (i : ℕ) : Submodule (R p) ℂ := (MR p M).comap ((LinearMap.toSpanSingleton ℂ V (vec y v i)).restrictScalars (R p))\\ndef unit {F W : Type} [Field F] [AddCommGroup W] [Module F W] (l : ℕ) (b : Module.Basis (Fin (l+1)) F W) (i j : Fin (l+1)) : Module.End F W := (b.coord j).smulRight (b i)\\nabbrev VK (K : Type) [Field K] (M : Submodule ℤ V) := TensorProduct ℤ K M\\nstructure Lift (M : Submodule ℤ V) (f : Module.End ℂ V) where\\n  map : Module.End ℤ M\\n  agrees : ∀ m : M, (map m : V) = f m\\nstructure Actions (M : Submodule ℤ V) (x y h : Module.End ℂ V) where\\n  lx : Lift M x\\n  ly : Lift M y\\n  lh : Lift M h\\n  dX : ∀ r : ℕ, Lift M (divided x r)\\n  dY : ∀ r : ℕ, Lift M (divided y r)\\ndef induced (K : Type) [Field K] (M : Submodule ℤ V) (f : Module.End ℤ M) : Module.End K (VK K M) := f.baseChange K\\ndef inv {F W : Type} [Field F] [AddCommGroup W] [Module F W] (W' : Submodule F W) (f : Module.End F W) : Prop := ∀ w ∈ W', f w ∈ W'\\ndef pMR (p : ℕ) (M : Submodule ℤ V) : Submodule (R p) (MR p M) := LinearMap.range ((p : R p) • (LinearMap.id : Module.End (R p) (MR p M)))\\nabbrev QMR (p : ℕ) (M : Submodule ℤ V) := (MR p M) ⧸ pMR p M\\n\\ndef Strings (l : ℕ) (x y h : Module.End ℂ V) (v : V) : Prop :=\\n  (∀ t : ℕ, h ((y^t) v) = ((l : ℂ)-2*(t : ℂ)) • (y^t) v) ∧\\n  (∀ t : ℕ, 1 ≤ t → x ((y^t) v) = ((t : ℂ)*((l : ℂ)-(t : ℂ)+1)) • (y^(t-1)) v) ∧\\n  (∀ i : ℕ, i ≤ l → vec y v i ≠ 0)\\ndef CBasis (l : ℕ) (y : Module.End ℂ V) (v : V) : Prop :=\\n  (∃ b : Module.Basis (Fin (l+1)) ℂ V, ∀ i, b i = vec y v i.val) ∧ (∀ t : ℕ, l < t → (y^t) v = 0)\\ndef BasicMatrices (l : ℕ) (x y h : Module.End ℂ V) (v : V) : Prop :=\\n  x (vec y v 0) = 0 ∧\\n  (∀ i : ℕ, 1 ≤ i → i ≤ l → x (vec y v i) = ((l-i+1 : ℕ) : ℂ) • vec y v (i-1)) ∧\\n  (∀ i : ℕ, i < l → y (vec y v i) = ((i+1 : ℕ) : ℂ) • vec y v (i+1)) ∧\\n  y (vec y v l) = 0 ∧\\n  (∀ i : ℕ, i ≤ l → h (vec y v i) = ((l : ℂ)-2*(i : ℂ)) • vec y v i)\\ndef DivMatrices (l : ℕ) (x y : Module.End ℂ V) (v : V) : Prop :=\\n  (∀ r i : ℕ, i ≤ l → divided x r (vec y v i) = if r ≤ i then ((Nat.choose (l-i+r) r : ℕ) : ℂ) • vec y v (i-r) else 0) ∧\\n  (∀ r i : ℕ, i ≤ l → divided y r (vec y v i) = if i+r ≤ l then ((Nat.choose (i+r) r : ℕ) : ℂ) • vec y v (i+r) else 0)\\ndef N1 (l : ℕ) (x y h : Module.End ℂ V) (v : V) : Prop := Strings l x y h v ∧ CBasis l y v ∧ BasicMatrices l x y h v ∧ DivMatrices l x y v\\n\\ndef LocalBasis (p l : ℕ) (M : Submodule ℤ V) : Prop :=\\n  (∃ f : TensorProduct ℤ (R p) M ≃ₗ[R p] MR p M, ∀ r m, (f (TensorProduct.tmul ℤ r m) : V) = r • (m : V)) ∧\\n  Nonempty (Module.Basis (Fin (l+1)) (R p) (MR p M)) ∧ Submodule.span ℂ (MR p M : Set V) = ⊤\\ndef LocalStable (p : ℕ) (M : Submodule ℤ V) (x y : Module.End ℂ V) : Prop :=\\n  ∀ r : ℕ, (∀ w ∈ MR p M, divided x r w ∈ MR p M) ∧ (∀ w ∈ MR p M, divided y r w ∈ MR p M)\\ndef PartialUnits (l : ℕ) (x y : Module.End ℂ V) (b : Module.Basis (Fin (l+1)) ℂ V) : Prop :=\\n  divided y l * divided x l = unit l b ⟨l, Nat.lt_succ_self l⟩ ⟨l, Nat.lt_succ_self l⟩ ∧\\n  (∀ i, divided x (l-i.val) * unit l b ⟨l, Nat.lt_succ_self l⟩ ⟨l, Nat.lt_succ_self l⟩ = unit l b i ⟨l, Nat.lt_succ_self l⟩) ∧\\n  (∀ j, unit l b ⟨l, Nat.lt_succ_self l⟩ ⟨l, Nat.lt_succ_self l⟩ * divided y (l-j.val) = ((Nat.choose l j.val : ℕ) : ℂ) • unit l b ⟨l, Nat.lt_succ_self l⟩ j)\\ndef AllUnits (p l : ℕ) (M : Submodule ℤ V) (x y : Module.End ℂ V) (b : Module.Basis (Fin (l+1)) ℂ V) : Prop :=\\n  (∀ j : Fin (l+1), IsUnit ((Nat.choose l j.val : ℕ) : R p)) ∧\\n  (∀ i j, unit l b i j = (((Nat.choose l j.val : ℕ) : ℂ)⁻¹) • (divided x (l-i.val) * (divided y l * divided x l) * divided y (l-j.val))) ∧\\n  (∀ i j w, w ∈ MR p M → unit l b i j w ∈ MR p M)\\ndef N2 (p l : ℕ) (M : Submodule ℤ V) (x y : Module.End ℂ V) (v : V) : Prop :=\\n  LocalBasis p l M ∧ LocalStable p M x y ∧ ∀ b : Module.Basis (Fin (l+1)) ℂ V, (∀ i, b i = vec y v i.val) → PartialUnits l x y b ∧ AllUnits p l M x y b\\n\\ndef Decomposition (p l : ℕ) (M : Submodule ℤ V) (y : Module.End ℂ V) (v : V) : Prop :=\\n  (∀ i : Fin (l+1), J p M y v i.val = J p M y v 0) ∧\\n  J p M y v 0 ≠ ⊥ ∧ Module.Finite (R p) (J p M y v 0) ∧\\n  (∀ w : V, w ∈ MR p M ↔ ∃ c : Fin (l+1) → ℂ, (∀ i, c i ∈ J p M y v 0) ∧ w = ∑ i, c i • vec y v i.val) ∧\\n  (∀ c : Fin (l+1) → ℂ, (∑ i, c i • vec y v i.val) = 0 → ∀ i, c i = 0)\\ndef TensorLine (p : ℕ) (M : Submodule ℤ V) (y : Module.End ℂ V) (v : V) : Prop :=\\n  ∃ mu : TensorProduct (R p) ℚ (J p M y v 0) →ₗ[ℚ] ℂ,\\n    (∀ q c, mu (TensorProduct.tmul (R p) q c) = q • (c : ℂ)) ∧ Function.Injective mu ∧\\n    LinearMap.range mu = Submodule.span ℚ (J p M y v 0 : Set ℂ) ∧ Module.Finite ℚ (TensorProduct (R p) ℚ (J p M y v 0))\\ndef RankOne (p : ℕ) (M : Submodule ℤ V) (y : Module.End ℂ V) (v : V) : Prop := Module.finrank ℚ (TensorProduct (R p) ℚ (J p M y v 0)) = 1\\ndef Generators (p : ℕ) (M : Submodule ℤ V) (y : Module.End ℂ V) (v : V) : Prop :=\\n  ∃ a : ℂ, a ∈ J p M y v 0 ∧ a ≠ 0 ∧ ∃ k : ℕ, 0 < k ∧ ∃ q : Fin k → ℚ,\\n    (∀ j, q j ≠ 0) ∧ J p M y v 0 = Submodule.span (R p) (Set.range (fun j => (q j : ℂ) * a))\\ndef Valuations (p : ℕ) (M : Submodule ℤ V) (y : Module.End ℂ V) (v : V) : Prop :=\\n  ∃ a : ℂ, a ∈ J p M y v 0 ∧ a ≠ 0 ∧ ∃ k : ℕ, 0 < k ∧ ∃ (nu : Fin k → ℤ) (u : Fin k → (R p)ˣ),\\n    J p M y v 0 = Submodule.span (R p) (Set.range (fun j => (((p : ℚ) ^ nu j * ((u j : R p) : ℚ) : ℚ) : ℂ) * a))\\ndef Generates (p : ℕ) (M : Submodule ℤ V) (y : Module.End ℂ V) (v : V) (b : ℂ) : Prop := b ∈ J p M y v 0 ∧ b ≠ 0 ∧ J p M y v 0 = Submodule.span (R p) {b}\\ndef ScaledBasis (p l : ℕ) (M : Submodule ℤ V) (y : Module.End ℂ V) (v : V) (b : ℂ) : Prop :=\\n  ∃ d : Module.Basis (Fin (l+1)) (R p) (MR p M), ∀ i, (d i : V) = b • vec y v i.val\\ndef N3 (p l : ℕ) (M : Submodule ℤ V) (y : Module.End ℂ V) (v : V) : Prop :=\\n  Decomposition p l M y v ∧ TensorLine p M y v ∧ RankOne p M y v ∧ (∃ b, Generates p M y v b) ∧\\n  (∀ b, Generates p M y v b → ScaledBasis p l M y v b)\\nend LR\\n\",\"parameters\":[{\"name\":\"p\",\"type\":\"ℕ\"},{\"name\":\"K\",\"type\":\"Type\"},{\"name\":\"fieldK\",\"type\":\"Field K\",\"binder_kind\":\"instance\"},{\"name\":\"l\",\"type\":\"ℕ\"},{\"name\":\"V\",\"type\":\"Type\"},{\"name\":\"addV\",\"type\":\"AddCommGroup V\",\"binder_kind\":\"instance\"},{\"name\":\"modV\",\"type\":\"Module ℂ V\",\"binder_kind\":\"instance\"},{\"name\":\"x\",\"type\":\"Module.End ℂ V\"},{\"name\":\"y\",\"type\":\"Module.End ℂ V\"},{\"name\":\"h\",\"type\":\"Module.End ℂ V\"},{\"name\":\"v\",\"type\":\"V\"},{\"name\":\"M\",\"type\":\"Submodule ℤ V\"}],\"premise_types\":{\"H001\":\"Nat.Prime p ∧ CharP K p ∧ l < p\",\"H002\":\"FiniteDimensional ℂ V ∧ Module.finrank ℂ V = l+1 ∧ h*x-x*h = (2 : ℂ) • x ∧ h*y-y*h = (-2 : ℂ) • y ∧ x*y-y*x = h ∧ (∀ W : Submodule ℂ V, LR.inv W x → LR.inv W y → LR.inv W h → W = ⊥ ∨ W = ⊤)\",\"H003\":\"v ≠ 0 ∧ x v = 0 ∧ h v = (l : ℂ) • v\",\"H004\":\"(∃ (ι : Type) (b : Module.Basis ι ℤ M) (c : Module.Basis ι ℂ V), ∀ i, (b i : V) = c i) ∧ (∀ r : ℕ, (∀ m : M, LR.divided x r m ∈ M) ∧ (∀ m : M, LR.divided y r m ∈ M))\"},\"conclusion_type\":\"∃ A : LR.Actions M x y h, Nontrivial (LR.VK K M) ∧ ∀ W : Submodule K (LR.VK K M), LR.inv W (LR.induced K M A.lx.map) → LR.inv W (LR.induced K M A.ly.map) → LR.inv W (LR.induced K M A.lh.map) → W = ⊥ ∨ W = ⊤\",\"representation\":\"Natural l represents the original nonnegative integer λ; l+1 and Fin (l+1) encode n and I. V is an arbitrary complex module with endomorphisms; the Chevalley relations and the generator-invariant-subspace condition encode the given irreducible representation. M is an arbitrary integer submodule, equivalently an additive subgroup, and its basis/admissibility assumptions are not minimal-lattice assumptions. LR.R is the rational subring generated by the prescribed fractions; T004 proves it consists exactly of those fractions. MR is its span in V, not an assumed tensor embedding. J is a comap, exactly the scalars carrying e_i into MR. Tensors put the scalar factor first; their flips give the original ordering. Actions contains actual integer restrictions with agreement equations, not assumed preservation. induced is Mathlib baseChange. Output predicates only package explicit statements; none supplies a proof. Matrix units are coordinate maps of an actual supplied basis. Quotients and all transport maps will be checked in local obligations.\",\"objects\":[],\"steps\":[],\"terminal\":\"T020\",\"source_outputs\":{\"N001\":\"T003\",\"N002\":\"T007\",\"N003\":\"T013\",\"N004\":\"T017\",\"P\":\"T020\"},\"endpoint_correspondence\":{\"P\":{\"mode\":\"equivalent\",\"explanation\":\"l ranges over naturals, identified bijectively with integers λ≥0; l<p is precisely the original bound. V, K, p, generators, highest vector and arbitrary M are universally parameterized. H002 encodes the complex Chevalley representation by its generators, dimension and irreducibility, and H003 supplies its nonzero highest-weight vector. An additive subgroup of V is uniquely an integer submodule, so H004 is exactly a shared integer/complex basis and stability under all divided powers; generator stability is equivalent to stability under their generated integer enveloping algebra. VK is K⊗Z M, identified with M⊗Z K by the canonical flip in both directions. Actions consists of restrictions to M with agreement in V; agreement determines each map uniquely because the inclusion M→V is injective. Existence is proved, not assumed. Its induced maps are exactly the original operators on pure tensors. Thus the existential choice of Actions neither weakens invariance nor adds a hypothesis: under H002,H004 restrictions exist and all choices coincide. Nontrivial is nonzeroness of the vector space, and bottom/top are zero/all subspaces. Invariance under x,y,h is equivalent to invariance under the abstract rank-three Chevalley Lie algebra, by its generator span; no faithfulness or distinct reduced weights, algebraic closure, p>2 or l>0 is imposed.\"}}}}","status":"completed"}],"error":null,"incomplete_details":null,"tools":[{"type":"function","name":"search_mathlib","description":"在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。","parameters":{"type":"object","properties":{"query":{"type":"string"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_mathlib","description":"读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。","parameters":{"type":"object","properties":{"path":{"type":"string"},"start_line":{"type":"integer"},"line_count":{"type":"integer"}},"required":["path","start_line","line_count"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"search_external_sources","description":"Follow source-retrieval.md: arxiv first (default; an exact arXiv ID is allowed), then google title/author search, then google title/author DOI search, then scihub with a confirmed DOI. Use browser:true for normal local-browser readback of JavaScript/verification pages. Results and DOI strings are locators, not source/theorem approval. Record failed access and continue conditionally when the original stays unavailable.","parameters":{"type":"object","properties":{"query":{"type":"string"},"engine":{"type":"string","enum":["arxiv","google","scihub"]},"browser":{"type":"boolean"}},"required":["query"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_external_source","description":"Read and retain a public HTTPS source and its hash-bound access record. Use offset to continue cached text. Retry with browser:true for a normal isolated local Chrome session if HTTPS needs JavaScript or verification. The optional browser uses ordinary site controls; unsupported challenges remain explicit failures. Verify full PDF identity, version, theorem and context yourself.","parameters":{"type":"object","properties":{"url":{"type":"string"},"offset":{"type":"integer"},"limit":{"type":"integer"},"browser":{"type":"boolean"}},"required":["url"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_task_input","description":"Read one declared frozen document. For JSON use pointer (empty string lists the root); large objects return keys, and strings resume with offset=next_offset. For text use inclusive start/end lines and column=next_column when continuing a long line. Every serialized result is at most 32 KiB. Follow has_more and the returned continuation coordinates; no arbitrary local files are accessible.","parameters":{"type":"object","properties":{"id":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"},"column":{"type":"integer"},"pointer":{"type":"string"},"offset":{"type":"integer"},"limit":{"type":"integer"}},"required":["id"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_yui","description":"Read declared Yui rules/templates; no tests, historical runs or personal files.","parameters":{"type":"object","properties":{"path":{"type":"string"},"start":{"type":"integer"},"end":{"type":"integer"},"column":{"type":"integer"}},"required":["path","start","end"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_artifact","description":"Check a JSON artifact against the explicit stage contract; this is not automatic mathematical certification.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_artifact","description":"Submit a JSON artifact after its stage checks.","parameters":{"type":"object","properties":{"artifact_json":{"type":"string"}},"required":["artifact_json"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"report_obstacle","description":"Report an actual obstacle using these five direct fields. Countercheck the alleged implication against the complete definitions, quantifiers and inequality directions; a feasible example alone does not determine an extremum. A fact not yet proved or registered in the current draft is an obligation to complete, not by itself a gap. For a mathematical stop, identify the concrete implication and actual mathematical difficulty encountered during normal checking/completion, not merely unfilled inventory or exposition. No fixed time/attempt count or counterexample is required. SUBSTANTIVE_GAP/SUSPECTED_GAP stop for an actual supported mathematical obstruction; INPUT_CONFLICT stops for incompatible inputs. In NL0, use source retrieval and explicit conditional deferral for unavailable primary texts; MISSING_SOURCE_STATEMENT requires that no complete secondary statement can be obtained. Other stages may report SOURCE_UNAVAILABLE for an actual access obstacle. Ordinary unfinished work is not an obstacle report. No mathematical acceptance is generated.","parameters":{"type":"object","properties":{"status":{"type":"string","enum":["SUBSTANTIVE_GAP","SUSPECTED_GAP","SOURCE_UNAVAILABLE","MISSING_SOURCE_STATEMENT","INPUT_CONFLICT"]},"location":{"type":"string"},"explanation":{"type":"string"},"basis":{"type":"string"},"partial_progress":{"type":"string"}},"required":["status","location","explanation","basis","partial_progress"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_draft","description":"Preferred structured-object form of check_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"submit_draft","description":"Preferred structured-object form of submit_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"save_interface_draft","description":"Save incomplete own-stage interface JSON without accepting it or invoking Lean. Later revise via base_candidate.","parameters":{"type":"object","properties":{"artifact":{"type":"object","additionalProperties":true}},"required":["artifact"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"read_interface_draft","description":"Read only own current-stage typed candidates or partial type probes; index lists them. No other stage files are accessible.","parameters":{"type":"object","properties":{"kind":{"type":"string","enum":["index","candidate","probe"]},"candidate":{"type":"integer"},"pointer":{"type":"string"}},"required":["kind","candidate","pointer"],"additionalProperties":false},"output_schema":null,"strict":false},{"type":"function","name":"check_lean_types","description":"Compile a partial mathematical definition header and selected Lean type or ordinary API term expressions with explicit parameters. Never accepts a final interface or adds a proved premise.","parameters":{"type":"object","properties":{"header":{"type":"string"},"parameters":{"type":"array","items":{"type":"object"}},"types":{"type":"array","items":{"type":"string"}}},"required":["header","parameters","types"],"additionalProperties":false},"output_schema":null,"strict":false}],"tool_choice":"auto","parallel_tool_calls":false,"prompt_cache_key":"80e904fa-00f4-4d76-a512-a4d07f29e177","prompt_cache_retention":"24h","text":{