RESOLVED_NAME:M102:Real.rpow_add_of_nonneg
RESOLVED_MODULE:M102:Mathlib.Analysis.SpecialFunctions.Pow.Real
BEGIN_SIGNATURE:M102
@Real.rpow_add_of_nonneg : ∀ {x y z : ℝ},
  LE.le.{0} 0 x →
    LE.le.{0} 0 y →
      LE.le.{0} 0 z →
        Eq.{1} (HPow.hPow.{0, 0, 0} x (HAdd.hAdd.{0, 0, 0} y z))
          (HMul.hMul.{0, 0, 0} (HPow.hPow.{0, 0, 0} x y) (HPow.hPow.{0, 0, 0} x z))
BEGIN_AXIOMS:M102
'Real.rpow_add_of_nonneg' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
