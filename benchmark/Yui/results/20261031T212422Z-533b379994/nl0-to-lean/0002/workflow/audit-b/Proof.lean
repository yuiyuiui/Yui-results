theorem yui_aux_0013 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ f : KdVPlan.Coeff, KdVPlan.invD (KdVPlan.dx f) = KdVPlan.P f ∧ KdVPlan.invD (KdVPlan.P f) = KdVPlan.invD f" := by
  intro f
  constructor
  · funext k
    by_cases hk : k = 0
    · simp [KdVPlan.invD, KdVPlan.P, hk]
    · have hki : Complex.I * (k : ℂ) ≠ 0 := mul_ne_zero Complex.I_ne_zero (by exact_mod_cast hk)
      simp only [KdVPlan.invD, KdVPlan.P, if_neg hk, KdVPlan.dx]
      exact inv_mul_cancel_left₀ hki (f k)
  · funext k
    by_cases hk : k = 0 <;> simp [KdVPlan.invD, KdVPlan.P, hk]

theorem yui_aux_0014 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ f : KdVPlan.Coeff, KdVPlan.MemH 1 f → Summable (fun k => ‖f k‖) ∧ (∑' k, ‖f k‖) ≤ (1 + KdVPlan.hn 0 (fun k => (Complex.I * (k : ℂ))⁻¹)) * KdVPlan.hn 1 f" := by
  intro f hf
  let D := KdVPlan.hn 0 (fun k => (Complex.I * (k : ℂ))⁻¹)
  have HD : 0 ≤ D := Real.sqrt_nonneg _
  have H := (yui_aux_0011 T gamma R h_T013).1 f hf
  have HI := yui_aux_0009 T gamma R h_T013 (KdVPlan.dx f) H.2.1
  have hs := yui_aux_0012 T gamma R h_T013 ‖f 0‖
  have he : (fun k => ‖f k‖) = (fun k => (if k = 0 then ‖f 0‖ else 0) + ‖KdVPlan.invD (KdVPlan.dx f) k‖) := by
   funext k
   rw [(yui_aux_0013 T gamma R h_T013 f).1]
   simp only [KdVPlan.P]
   split_ifs with hk <;> simp [hk]
  have hpt : ‖f 0‖ ≤ KdVPlan.hn 1 f := by
   let x : lp (fun _ : ℤ => ℂ) 2 := ⟨f, (yui_aux_0003 T gamma R h_T013 f).1.mp H.1.1⟩
   have hnorm : KdVPlan.hn 0 f = ‖x‖ := (yui_aux_0003 T gamma R h_T013 f).2 _
   exact (lp.norm_apply_le_norm (by norm_num : (2 : ℝ≥0∞) ≠ 0) x 0).trans (hnorm ▸ H.1.2)
  refine ⟨he ▸ hs.1.add HI.2.1, ?_⟩
  calc
   (∑' k, ‖f k‖) = ‖f 0‖ + ∑' k, ‖KdVPlan.invD (KdVPlan.dx f) k‖ := by rw [he, hs.1.tsum_add HI.2.1, hs.2]
   _ ≤ KdVPlan.hn 1 f + D * KdVPlan.hn 1 f := add_le_add hpt (HI.2.2.trans (mul_le_mul_of_nonneg_left H.2.2 HD))
   _ = (1 + D) * KdVPlan.hn 1 f := by ring

theorem yui_aux_0015 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "(∀ f g : KdVPlan.Coeff, KdVPlan.mul f g = KdVPlan.mul g f) ∧\n (∀ f g : KdVPlan.Coeff, KdVPlan.MemH 1 f → KdVPlan.MemH 1 g → KdVPlan.dx (KdVPlan.mul f g) = KdVPlan.mul (KdVPlan.dx f) g + KdVPlan.mul f (KdVPlan.dx g))" := by
  constructor
  · intro f g
    funext k
    change (∑' j : ℤ, f j * g (k-j)) = ∑' j : ℤ, g j * f (k-j)
    calc
     (∑' j : ℤ, f j * g (k-j)) = ∑' j : ℤ, f (k-j) * g (k-(k-j)) := ((Equiv.subLeft k).tsum_eq _).symm
     _ = ∑' j : ℤ, g j * f (k-j) := by apply tsum_congr; intro j; simp [mul_comm]
  · intro f g hf hg
