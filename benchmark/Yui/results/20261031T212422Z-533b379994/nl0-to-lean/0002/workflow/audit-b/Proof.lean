   KdVPlan.hn 0 (KdVPlan.mul f g) = ‖w‖ := (congrArg (KdVPlan.hn 0) hw).trans ((yui_aux_0003 T gamma R h_T013 _).2 w.prop)
   _ ≤ ∑' j, ‖v j‖ := norm_tsum_le_tsum_norm hv
   _ = (∑' j, ‖f j‖)*KdVPlan.hn 0 g := by simp only [hvn, tsum_mul_right]

theorem yui_aux_0008 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "(∀ f : KdVPlan.Coeff, ∀ k : ℤ, KdVPlan.invD f k = (Complex.I * (k : ℂ))⁻¹ * f k ∧ ‖KdVPlan.invD f k‖ = |(k : ℝ)|⁻¹ * ‖f k‖ ∧ ‖KdVPlan.dx f k‖ = |(k : ℝ)| * ‖f k‖) ∧ KdVPlan.MemH 0 (fun k => (Complex.I * (k : ℂ))⁻¹)" := by
