theorem yui_aux_0023 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ s r q : ℝ, ∀ A : KdVPlan.Coeff → KdVPlan.Coeff → KdVPlan.Coeff, ∀ C : ℝ, 0 ≤ C →\n (∀ f g, KdVPlan.MemH s f → KdVPlan.MemH r g → KdVPlan.HB q (A f g) (C*KdVPlan.hn s f*KdVPlan.hn r g)) →\n (∀ f f' g g', KdVPlan.MemH s f → KdVPlan.MemH s f' → KdVPlan.MemH r g → KdVPlan.MemH r g' →\n A f g-A f' g' = A (f-f') g+A f' (g-g')) → KdVPlan.FourierApprox2 s r q A" := by
  intro s r q A C hC hB hdiff f g hf hg
  refine ⟨(hB f g hf hg).1, ?_⟩
  intro ε hε
  let K := C*(KdVPlan.hn s f+KdVPlan.hn r g)
  have hnf : 0 ≤ KdVPlan.hn s f := Real.sqrt_nonneg _
  have hng : 0 ≤ KdVPlan.hn r g := Real.sqrt_nonneg _
