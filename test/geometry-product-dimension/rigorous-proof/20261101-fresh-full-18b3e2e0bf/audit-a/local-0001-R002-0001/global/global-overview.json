      "record": {
        "id": "N001",
        "kind": "internal",
        "statement": "For every integer m≥0, every A⊆ℝ^m and every s>0, H^s(A)=h^s(A). Moreover dim_H(A)≥0; s<dim_H(A) implies H^s(A)=∞; dim_H(A)<s implies H^s(A)=0; H^s(A)<∞ implies dim_H(A)≤s (in particular H^s(A)=0 does); and H^s(A)=∞ implies dim_H(A)≥s.",
        "definitions": [
