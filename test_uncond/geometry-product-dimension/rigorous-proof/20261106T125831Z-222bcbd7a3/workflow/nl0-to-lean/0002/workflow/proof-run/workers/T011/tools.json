[
  {
    "type": "function",
    "name": "search_mathlib",
    "description": "Search the pinned mathlib Lean source using a regular expression; at most 100 lines.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "read_mathlib",
    "description": "Read specified lines of a Mathlib/*.lean source file from the pinned checkout.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer"
        },
        "line_count": {
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start_line",
        "line_count"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "check_transition",
    "description": "Compile a tactic body for the fixed target; no leading by, declarations, or placeholders.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "proof": {
          "type": "string"
        }
      },
      "required": [
        "proof"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "submit_transition",
    "description": "Submit and check the final tactic body for the same target.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "proof": {
          "type": "string"
        }
      },
      "required": [
        "proof"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "check_auxiliary",
    "description": "Compile one helper proposition and tactic body in exactly this local port context. This never accepts the final goal or adds a premise.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "statement": {
          "type": "string"
        },
        "proof": {
          "type": "string"
        }
      },
      "required": [
        "statement",
        "proof"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "read_lean_draft",
    "description": "Read only your own same-stage proof/helper attempts. kind=index lists attempts; proof/auxiliary returns the selected body lines and actual check. No other stage or file is accessible.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "index",
            "proof",
            "auxiliary"
          ]
        },
        "candidate": {
          "type": "integer"
        },
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "candidate",
        "start",
        "end"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "report_proof_obstruction",
    "description": "Request diagnosis while retaining this author. Reference current packet pointers and at most six actual own attempts. A source allegation requires source_issue with a verbatim source_quote and the mathematical defect. Ordinary errors, resource exhaustion or inability do not authorize ending the task.",
    "inputSchema": {
      "type": "object",
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "explanation": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 12000
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/"
              },
              "minItems": 1,
              "maxItems": 12
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "proof",
                      "auxiliary"
                    ]
                  },
                  "candidate": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "candidate",
                  "kind"
                ],
                "additionalProperties": false
              },
              "maxItems": 6
            },
            "source_issue": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "FALSE_IMPLICATION",
                    "MISSING_JUSTIFICATION"
                  ]
                },
                "source_quote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 12000
                },
                "hypotheses": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 12000
                },
                "claim": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 12000
                },
                "defect": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 12000
                },
                "why_not_lean_difficulty": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 12000
                }
              },
              "required": [
                "claim",
                "defect",
                "hypotheses",
                "kind",
                "source_quote",
                "why_not_lean_difficulty"
              ],
              "additionalProperties": false
            },
            "layer": {
              "const": "source"
            }
          },
          "required": [
            "candidates",
            "explanation",
            "layer",
            "locations",
            "source_issue"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "explanation": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 12000
            },
            "locations": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/"
              },
              "minItems": 1,
              "maxItems": 12
            },
            "candidates": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "kind": {
                    "enum": [
                      "proof",
                      "auxiliary"
                    ]
                  },
                  "candidate": {
                    "type": "integer",
                    "minimum": 1
                  }
                },
                "required": [
                  "candidate",
                  "kind"
                ],
                "additionalProperties": false
              },
              "maxItems": 6
            },
            "source_issue": {
              "type": "object",
              "properties": {
                "kind": {
                  "enum": [
                    "FALSE_IMPLICATION",
                    "MISSING_JUSTIFICATION"
                  ]
                },
                "source_quote": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 12000
                },
                "hypotheses": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 12000
                },
                "claim": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 12000
                },
                "defect": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 12000
                },
                "why_not_lean_difficulty": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S",
                  "maxLength": 12000
                }
              },
              "required": [
                "claim",
                "defect",
                "hypotheses",
                "kind",
                "source_quote",
                "why_not_lean_difficulty"
              ],
              "additionalProperties": false
            },
            "layer": {
              "enum": [
                "interface",
                "unknown"
              ]
            }
          },
          "required": [
            "candidates",
            "explanation",
            "layer",
            "locations"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
]
