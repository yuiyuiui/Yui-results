theorem yui_aux_0019 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "Summable (fun k : ℤ => KdVPlan.weight (-KdVPlan.pstar) k * (k : ℝ)^2) ∧ ∀ k : ℤ, k ≠ 0 → KdVPlan.weight (-KdVPlan.pstar) k ≤ (k : ℝ)⁻¹^2" := by
