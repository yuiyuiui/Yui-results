BEGIN_SIGNATURE:M007
@hasDerivAt_pi : ∀ {𝕜 : Type u} [inst : NontriviallyNormedField.{u} 𝕜] {x : 𝕜} {ι : Type u_1} {E' : ι → Type u_2}
  [inst_1 : (i : ι) → NormedAddCommGroup.{u_2} (E' i)] [inst_2 : (i : ι) → NormedSpace.{u, u_2} 𝕜 (E' i)]
  {φ : 𝕜 → (i : ι) → E' i} {φ' : (i : ι) → E' i},
  HasDerivAt.{u, max u_1 u_2} φ φ' x ↔ ∀ (i : ι), HasDerivAt.{u, u_2} (fun x => φ x i) (φ' i) x
BEGIN_AXIOMS:M007
'hasDerivAt_pi' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
