theorem yui_aux_0006 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ f : KdVPlan.Coeff, ∀ j : ℤ, KdVPlan.MemH 0 f → KdVPlan.MemH 0 (fun k => f (k-j)) ∧ KdVPlan.hn 0 (fun k => f (k-j)) = KdVPlan.hn 0 f" := by
