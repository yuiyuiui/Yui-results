          apply Finset.sum_congr rfl
          intro k hk
          congr 1
          ext p
          congr 2
          omega
        _ ≤ ∑' k : ℤ, ∑' p : ℤ × ℤ, ‖U (p.1,p.2,k-p.1-p.2)‖ * w (p.1+p.2+(k-p.1-p.2)) :=
          Summable.sum_le_tsum F (fun k hk => tsum_nonneg (fun p => mul_nonneg (norm_nonneg _) (hw.2.1 _))) ht.2.1
    have hbound := hle.trans (hh w hw).2
