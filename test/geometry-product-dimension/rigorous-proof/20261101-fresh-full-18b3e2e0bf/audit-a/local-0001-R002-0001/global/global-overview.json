  "definitions": [
    {
      "pointer": "spec.json#/definitions/0",
      "record": {
        "id": "D001",
        "symbol": "diam",
        "type": "extended nonnegative diameter of a subset of an extended metric space",
        "definition": "For an extended metric space X and A⊆X, diam(A)=sup{edist(x,y):x,y∈A}, with diam(∅)=0. On an ordinary metric space edist is the usual distance embedded in [0,∞], and unbounded sets have diameter ∞. On a bounded set in an ordinary metric space the diameter is a nonnegative real. For every nonnegative integer m, Euclidean space ℝ^m has distance (sum_{j=1}^m (x_j-y_j)^2)^(1/2); ℝ^0 is a singleton. All Euclidean sets below use this metric.",
        "depends_on": [],
        "requires": [],
        "binders": [
          {
            "symbol": "X",
            "type": "extended metric space"
          },
          {
            "symbol": "A",
            "type": "subset of X"
          },
          {
            "symbol": "m",
            "type": "nonnegative integer"
          }
        ],
        "objects": [
          "X",
          "A",
          "m"
        ]
      }
    },
    {
      "pointer": "spec.json#/definitions/1",
      "record": {
        "id": "D002",
        "symbol": "H",
        "type": "scale contents H^s_δ and unnormalized Hausdorff measures H^s, valued in [0,∞]",
        "definition": "For a Euclidean set \\(A\\), exponent \\(s>0\\), and scale \\(\\delta>0\\), put\n\n\\[\nH^s_\\delta(A)=\\inf\\left\\{\\sum_i(\\operatorname{diam}U_i)^s:\n A\\subseteq\\bigcup_iU_i,\\quad\\operatorname{diam}U_i\\leq\\delta\\right\\},\n\\qquad H^s(A)=\\sup_{\\delta>0}H^s_\\delta(A).\n\\]\n\nCovers are countable, with empty members contributing zero. This\nunnormalized Hausdorff measure gives the usual Hausdorff dimension.\n",
        "depends_on": [
          "D001"
        ],
        "requires": [],
        "binders": [
          {
            "symbol": "A",
            "type": "subset of a Euclidean space"
          },
          {
            "symbol": "s",
            "type": "positive real exponent"
          },
          {
            "symbol": "δ",
            "type": "positive real scale"
          },
          {
            "symbol": "U",
            "type": "countable family of covering sets"
          }
        ],
        "objects": [
          "A",
          "s",
          "δ",
          "U"
        ]
      }
    },
    {
      "pointer": "spec.json#/definitions/2",
      "record": {
        "id": "D003",
        "symbol": "h",
        "type": "native unnormalized Hausdorff measure family on extended metric spaces",
        "definition": "For an extended metric space X equipped with its Borel measurable structure, h^a(A) denotes Mathlib's MeasureTheory.Measure.hausdorffMeasure a evaluated on A⊆X. For every real exponent a this is the metric outer-measure construction from the gauge r↦r^a on [0,∞], with empty covering sets contributing zero. At exponent zero the native convention is used; at every positive exponent 0^a=0. Values on arbitrary sets mean outer measure, so no measurability of A is stipulated.",
        "depends_on": [
          "D001"
        ],
        "requires": [],
        "binders": [
          {
            "symbol": "X",
            "type": "extended metric space with Borel measurable structure"
          },
          {
            "symbol": "A",
            "type": "subset of X"
          },
          {
            "symbol": "a",
            "type": "real number"
          }
        ],
        "objects": [
