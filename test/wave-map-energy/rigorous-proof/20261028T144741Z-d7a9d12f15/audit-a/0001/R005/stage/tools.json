[
  {
    "type": "function",
    "name": "search_mathlib",
    "description": "在固定 mathlib 的 Lean 源码中搜索正则表达式，返回至多 100 行。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "read_mathlib",
    "description": "读取固定 mathlib 中一个 Mathlib/...lean 文件的指定行。",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "start_line": {
          "type": "integer"
        },
        "line_count": {
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start_line",
        "line_count"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "read_task_input",
    "description": "Read one declared frozen document. For JSON use pointer (empty string lists the root); large objects return keys, and strings resume with offset=next_offset. For text use inclusive start/end lines and column=next_column when continuing a long line. Every serialized result is at most 32 KiB. Follow has_more and the returned continuation coordinates; no arbitrary local files are accessible.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        },
        "column": {
          "type": "integer"
        },
        "pointer": {
          "type": "string"
        },
        "offset": {
          "type": "integer"
        },
        "limit": {
          "type": "integer"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "read_yui",
    "description": "Read declared Yui rules/templates; no tests, historical runs or personal files.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "start": {
          "type": "integer"
        },
        "end": {
          "type": "integer"
        },
        "column": {
          "type": "integer"
        }
      },
      "required": [
        "path",
        "start",
        "end"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "check_artifact",
    "description": "Check a JSON artifact against the explicit stage contract; this is not automatic mathematical certification.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "artifact_json": {
          "type": "string"
        }
      },
      "required": [
        "artifact_json"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "submit_artifact",
    "description": "Submit a JSON artifact after its stage checks.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "artifact_json": {
          "type": "string"
        }
      },
      "required": [
        "artifact_json"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "check_draft",
    "description": "Preferred structured-object form of check_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "submit_draft",
    "description": "Preferred structured-object form of submit_artifact: provide artifact as an actual JSON object, not an escaped JSON string. Same complete validation and acceptance scope.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "artifact"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "record_review_item",
    "description": "Save an actual own-stage judgment and coverage; does not finish review.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "pointer": {
          "type": "string"
        },
        "coverage": {
          "type": "string",
          "enum": [
            "unread",
            "read",
            "assessed"
          ]
        },
        "judgment": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": true
        }
      },
      "required": [
        "pointer",
        "coverage",
        "judgment"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "read_review_progress",
    "description": "Read actual own-stage saved judgments and remaining work.",
    "inputSchema": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "submit_review_blocker",
    "description": "Finish an explicitly incomplete review after a located real defect. Does not grant acceptance.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "finding": {
          "type": "object",
          "additionalProperties": true
        }
      },
      "required": [
        "finding"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "probe_background",
    "description": "Read-only native verification of a basic theorem in pinned Mathlib. No new mathematical hypothesis or target proof is supplied. Use an Mnnn ID and a declaration name, not Lean code.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "declaration": {
          "type": "string"
        },
        "module": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "declaration"
      ],
      "additionalProperties": false
    }
  },
  {
    "type": "function",
    "name": "record_background_note",
    "description": "Record YOUR positively checked routine elementary inference or omitted basic Mathlib use. Check actual local conditions, mathematical correctness and routine scope. Does not establish PASS automatically. For mathlib first probe_background, then give its source_id. No guessed theorem, extra hypothesis, substantial gap or external citation qualifies.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "elementary",
            "mathlib"
          ]
        },
        "at": {
          "type": "string"
        },
        "fact": {
          "type": "string"
        },
        "justification": {
          "type": "string"
        },
        "grounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "location",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "source_id": {
          "type": "string"
        },
        "hint": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "at",
        "fact",
        "grounds",
        "justification"
      ],
      "additionalProperties": false
    }
  }
]
