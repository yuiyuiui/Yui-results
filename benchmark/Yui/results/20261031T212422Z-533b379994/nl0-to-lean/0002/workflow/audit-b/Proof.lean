  intro N f hf
  unfold KdVPlan.ZeroMean KdVPlan.cutoff
  split_ifs
  · exact hf
  · rfl

theorem yui_aux_0046 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_E003 : KdVPlan.ETri) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ (s : ℝ) (f g : KdVPlan.Coeff), KdVPlan.ZeroMean f → KdVPlan.ZeroMean g → KdVPlan.ZeroMean (f-g)" := by
  intro s f g hf hg
  change f 0-g 0 = 0
  rw [hf, hg, sub_self]

theorem yui_aux_0047 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_E003 : KdVPlan.ETri) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ (s : ℝ) (f : ℕ → KdVPlan.Coeff) (g : KdVPlan.Coeff), KdVPlan.SeqConv s f g → Tendsto (fun n => KdVPlan.hn s (f n-g)) atTop (nhds 0)" := by
  intro s f g hf
  apply Metric.tendsto_atTop.mpr
  intro ε hε
  obtain ⟨m, hm⟩ := hf.2 (ε/2) (half_pos hε)
  refine ⟨m, fun n hn => ?_⟩
  have hb := (hm n hn).2
  have hp : 0 ≤ KdVPlan.hn s (f n-g) := Real.sqrt_nonneg _
  simpa only [Real.dist_eq, sub_zero, abs_of_nonneg hp] using (lt_of_le_of_lt hb (half_lt_self hε))

theorem yui_aux_0048 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_E003 : KdVPlan.ETri) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ (s : ℝ) (f : ℕ → KdVPlan.Coeff) (g : KdVPlan.Coeff), (∀ n, KdVPlan.MemH s (f n)) → KdVPlan.SeqConv s f g → Tendsto (fun n => KdVPlan.hn s (f n)) atTop (nhds (KdVPlan.hn s g))" := by
