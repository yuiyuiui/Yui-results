  {
    "type": "function",
    "name": "record_background_note",
    "description": "Optionally checkpoint YOUR positively checked routine mathematical or elementary fact, precise statement and actual available conditions. A complete review may submit these notes together. Exact Mathlib bindings belong to nl02lean. No new H, core missing argument or uncertain external source qualifies; this tool never generates PASS.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "elementary",
            "mathematical"
          ]
        },
        "at": {
          "type": "string"
        },
        "fact": {
          "type": "string"
        },
        "justification": {
          "type": "string"
        },
        "grounds": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "location": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "location",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "hint": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "at",
        "fact",
        "grounds",
        "justification"
      ],
      "additionalProperties": false
    }
  }
