BEGIN_SIGNATURE:M115
@MeasureTheory.integral_add : ∀ {α : Type u_1} {G : Type u_5} [inst : NormedAddCommGroup.{u_5} G] [inst_1 : NormedSpace.{0, u_5} ℝ G]
  {m : MeasurableSpace.{u_1} α} {μ : MeasureTheory.Measure.{u_1} α} {f g : α → G},
  MeasureTheory.Integrable.{u_5, u_1} f μ →
    MeasureTheory.Integrable.{u_5, u_1} g μ →
      Eq.{u_5 + 1} (∫ (a : α), HAdd.hAdd.{u_5, u_5, u_5} (f a) (g a) ∂μ)
        (HAdd.hAdd.{u_5, u_5, u_5} (∫ (a : α), f a ∂μ) (∫ (a : α), g a ∂μ))
BEGIN_AXIOMS:M115
'MeasureTheory.integral_add' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
