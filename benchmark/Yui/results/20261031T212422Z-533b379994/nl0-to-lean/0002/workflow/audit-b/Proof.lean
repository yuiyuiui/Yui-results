theorem yui_aux_0022 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "(∀ t : ℝ, ∀ f g : KdVPlan.Coeff, KdVPlan.MemH 0 f → KdVPlan.MemH 0 g →\n KdVPlan.HB 1 (KdVPlan.J t f g) (12 * (1 + KdVPlan.hn 0 (fun k => (Complex.I*(k : ℂ))⁻¹))*KdVPlan.hn 0 f*KdVPlan.hn 0 g)) ∧\n (∀ t : ℝ, ∀ A g : KdVPlan.Coeff, KdVPlan.MemH 0 (KdVPlan.invD A) → KdVPlan.MemH 0 g →\n KdVPlan.HB 0 (KdVPlan.J t A g) (KdVPlan.hn 0 (fun k => (Complex.I*(k : ℂ))⁻¹)*KdVPlan.hn 0 (KdVPlan.invD A)*KdVPlan.hn 0 g))" := by
