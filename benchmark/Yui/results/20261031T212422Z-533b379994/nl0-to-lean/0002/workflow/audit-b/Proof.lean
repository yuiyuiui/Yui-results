theorem yui_aux_0001 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_H001 : 0 < T) (h_H002 : 0 < gamma ∧ gamma ≤ 1) (h_H003 : 0 < R) (h_T001 : KdVPlan.FlowOutput T gamma R) (h_T007 : KdVPlan.SchemeOutput) (h_T011 : KdVPlan.SmoothOutput T gamma R) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ s : ℝ, ∀ f g : KdVPlan.Coeff, KdVPlan.MemH s f → KdVPlan.MemH s g → KdVPlan.MemH s (f-g) ∧ KdVPlan.hn s (f-g) ≤ KdVPlan.hn s f + KdVPlan.hn s g ∧ |KdVPlan.hn s f-KdVPlan.hn s g| ≤ KdVPlan.hn s (f-g)" := by
