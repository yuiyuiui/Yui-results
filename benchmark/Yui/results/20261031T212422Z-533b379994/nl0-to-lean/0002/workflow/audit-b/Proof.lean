theorem yui_aux_0007 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_E003 : KdVPlan.ETri) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ (f : KdVPlan.Coeff), KdVPlan.MemH 0 f → ∀ k : ℤ, ‖f k‖ ≤ KdVPlan.hn 0 f" := by
