RESOLVED_MODULE:M013:Mathlib.Topology.Compactness.Compact
BEGIN_SIGNATURE:M013
@IsCompact.elim_finite_subcover : ∀ {X : Type u} [inst : TopologicalSpace.{u} X] {s : Set.{u} X} {ι : Type v},
  IsCompact.{u} s →
    ∀ (U : ι → Set.{u} X),
      (∀ (i : ι), IsOpen.{u} (U i)) → s ⊆ ⋃ i, U i → ∃ t, s ⊆ ⋃ i, ⋃ (_ : Membership.mem.{v, v} t i), U i
BEGIN_AXIOMS:M013
'IsCompact.elim_finite_subcover' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
