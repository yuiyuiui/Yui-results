      (∑' j : ℤ, KdVPlan.dx f j * g (k-j)) + ∑' j : ℤ, f j * KdVPlan.dx g (k-j)
    rw [← tsum_mul_left, ← h₁.tsum_add h₂]
    apply tsum_congr
    intro j
    simp only [KdVPlan.dx, Int.cast_sub]
    ring

theorem yui_aux_0016 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ f g : KdVPlan.Coeff, KdVPlan.MemH 1 f → KdVPlan.MemH 1 g →\n KdVPlan.HB 1 (KdVPlan.mul f g) (3 * (1 + KdVPlan.hn 0 (fun k => (Complex.I * (k : ℂ))⁻¹)) * KdVPlan.hn 1 f * KdVPlan.hn 1 g)" := by
