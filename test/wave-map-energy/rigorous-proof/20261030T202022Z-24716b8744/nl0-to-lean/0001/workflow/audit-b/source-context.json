    {
      "id": "D001",
      "symbol": "V",
      "type": "real Euclidean vector space with measure",
      "definition": "V=R^n, realized as tuples (x_1,...,x_n). Its topology is the Euclidean topology and its measure dx is the product of n one-dimensional Lebesgue measures. Compactness, continuity and derivatives use these topologies; integrable means Lebesgue absolutely integrable.",
      "depends_on": [],
      "requires": [],
      "binders": [],
      "objects": [
        "n"
      ]
    },
    {
      "id": "D002",
      "symbol": "W",
      "type": "real Euclidean vector space",
      "definition": "W=R^m with inner product v·w=sum_{k=1}^m v_k w_k and norm |v|=(sum_{k=1}^m v_k^2)^(1/2). On V the same convention uses n coordinates. The squared norm and dot product in all formulas have this meaning.",
      "depends_on": [],
      "requires": [],
      "binders": [
        {
          "symbol": "v",
          "type": "vector in W"
        },
        {
          "symbol": "w",
