theorem yui_aux_0018 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T002 : KdVPlan.CovarianceBounds) (h_T003 : KdVPlan.FourFrequency) (h_T017 : KdVPlan.MultiplierBound) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ (s : ℝ) (A : KdVPlan.Coeff → KdVPlan.Coeff → KdVPlan.Coeff → KdVPlan.Coeff),\n KdVPlan.BoundedTri s A → KdVPlan.FourierApprox3 s A" := by
