RESOLVED_NAME:M009:Real.mul_rpow
RESOLVED_MODULE:M009:Mathlib.Analysis.SpecialFunctions.Pow.Real
BEGIN_SIGNATURE:M009
@Real.mul_rpow : ∀ {x y z : ℝ},
  LE.le.{0} 0 x →
    LE.le.{0} 0 y →
      Eq.{1} (HPow.hPow.{0, 0, 0} (HMul.hMul.{0, 0, 0} x y) z)
        (HMul.hMul.{0, 0, 0} (HPow.hPow.{0, 0, 0} x z) (HPow.hPow.{0, 0, 0} y z))
BEGIN_AXIOMS:M009
'Real.mul_rpow' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
END_SOURCE:M009
