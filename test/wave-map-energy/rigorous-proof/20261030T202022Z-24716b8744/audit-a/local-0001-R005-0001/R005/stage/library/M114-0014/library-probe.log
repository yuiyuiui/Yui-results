BEGIN_SIGNATURE:M114
@Continuous.comp : ∀ {X : Type u_1} {Y : Type u_2} {Z : Type u_3} [inst : TopologicalSpace.{u_1} X] [inst_1 : TopologicalSpace.{u_2} Y]
  [inst_2 : TopologicalSpace.{u_3} Z] {f : X → Y} {g : Y → Z},
  Continuous.{u_2, u_3} g →
    Continuous.{u_1, u_2} f → Continuous.{u_1, u_3} (Function.comp.{u_1 + 1, u_2 + 1, u_3 + 1} g f)
