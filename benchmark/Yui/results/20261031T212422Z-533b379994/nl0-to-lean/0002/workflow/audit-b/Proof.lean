theorem yui_aux_0010 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_E003 : KdVPlan.ETri) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ (a b s : ℝ) (f : KdVPlan.Path), s ≤ 0 → KdVPlan.ContH 0 a b f → KdVPlan.EssBound s a b f" := by
