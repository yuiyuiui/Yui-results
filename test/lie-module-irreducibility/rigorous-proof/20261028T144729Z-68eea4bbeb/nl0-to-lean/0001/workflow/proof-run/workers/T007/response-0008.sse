ens":0,"cache_write_tokens":0,"output_tokens":0},"rs_04a6a1cfabf00d36016ae2188369b08191be03e27f74a4407e":{"input_tokens":204,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"rs_04a6a1cfabf00d36016ae2189c97fc8191a128cddad6a0ab86":{"input_tokens":60,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}},"request_fields":{"instructions":{"input_tokens":827,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0},"tools":{"input_tokens":395,"cached_tokens":0,"cache_write_tokens":0,"output_tokens":0}}}},"tool_usage":{"image_gen":{"input_tokens":0,"output_tokens":0,"total_tokens":0,"input_tokens_details":{"text_tokens":0,"image_tokens":0},"output_tokens_details":{"image_tokens":0,"text_tokens":0}},"web_search":{"num_requests":0}},"safety_identifier":"user-EpSBagPYSg8yOGllmjblVHlJ","store":false,"metadata":{},"max_output_tokens":null,"max_tool_calls":null,"service_tier":"default","truncation":"disabled"}}

