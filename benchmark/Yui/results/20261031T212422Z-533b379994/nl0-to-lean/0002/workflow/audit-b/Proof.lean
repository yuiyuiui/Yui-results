theorem yui_aux_0005 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ f g : KdVPlan.Coeff, KdVPlan.MemH 0 f → KdVPlan.MemH 0 g → \n (Summable (fun j => ‖f j‖*‖g j‖) ∧ (∑' j, ‖f j‖*‖g j‖) ≤ KdVPlan.hn 0 f*KdVPlan.hn 0 g) ∧\n ∀ k, Summable (fun j => f j*g (k-j)) ∧ ‖KdVPlan.mul f g k‖ ≤ KdVPlan.hn 0 f*KdVPlan.hn 0 g" := by
  intro f g hf hg
  have cs : ∀ a b : KdVPlan.Coeff, KdVPlan.MemH 0 a → KdVPlan.MemH 0 b → Summable (fun j => ‖a j‖*‖b j‖) ∧ (∑' j, ‖a j‖*‖b j‖) ≤ KdVPlan.hn 0 a*KdVPlan.hn 0 b := by
   intro a b ha hb
