# Keep credentials, databases and caches private; retain execution evidence.
!**/.runtime-home/
**/.runtime-home/*
!**/.runtime-home/config.toml
!**/.runtime-home/sessions/
*.olean
*.ilean
*.tmp

# Supplement source, configuration and logs are evidence; build/cache state is local.
**/native-home/*
!**/native-home/config.toml
!**/native-home/sessions/
**/review-*-home/*
!**/review-*-home/config.toml
!**/review-*-home/sessions/
