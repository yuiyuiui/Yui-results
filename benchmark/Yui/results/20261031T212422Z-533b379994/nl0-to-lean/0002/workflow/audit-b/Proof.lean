theorem T017 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T002 : KdVPlan.CovarianceBounds) (h_T003 : KdVPlan.FourFrequency) :
    KdVPlan.MultiplierBound := by
  intro σ τ hσ hσ1 hτ a b c
  dsimp only
  intro hi hp
  let k : ℤ := a+b+c
  let E : ℝ := ‖KdVPlan.eta τ (3*(a:ℝ)*(b:ℝ)*(a+b:ℤ))
    (3*(k:ℝ)*(c:ℝ)*(a+b:ℤ))‖
  have ha : (a:ℝ) ≠ 0 := by exact_mod_cast hi.2.1
  have hb : (b:ℝ) ≠ 0 := by exact_mod_cast hi.2.2.1
  have hc : (c:ℝ) ≠ 0 := by exact_mod_cast hi.2.2.2.1
  have hkz : k ≠ 0 := by
    intro hz
    exact hi.2.2.2.2 (by change -k = 0; rw [hz, neg_zero])
  have hk : (k:ℝ) ≠ 0 := by exact_mod_cast hkz
  have haP : 0 < |(a:ℝ)| := abs_pos.mpr ha
  have hbP : 0 < |(b:ℝ)| := abs_pos.mpr hb
  have hcP : 0 < |(c:ℝ)| := abs_pos.mpr hc
  have hkP : 0 < |((-k:ℤ):ℝ)| := by simpa using abs_pos.mpr hk
  have hN : 0 < KdVPlan.n3 a b c (-k) := by
    simp only [KdVPlan.n3, lt_min_iff, lt_max_iff]
    tauto
  have hQ : 0 < |(a:ℝ)*(b:ℝ)*(c:ℝ)| :=
    abs_pos.mpr (mul_ne_zero (mul_ne_zero ha hb) hc)
  have hend := @yui_aux_0003 T gamma R h_T002 h_T003 τ a b c hτ hi hp
  have hinter := @yui_aux_0004 T gamma R h_T002 h_T003
    (E/|(k:ℝ)|) |(a:ℝ)*(b:ℝ)*(c:ℝ)| (KdVPlan.n3 a b c (-k)) τ σ
    (div_nonneg (norm_nonneg _) (abs_nonneg _)) hQ hN hτ hσ hσ1 hend.1 hend.2
  simpa only [div_div] using hinter

namespace Local_T004
theorem yui_aux_0001 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T002 : KdVPlan.CovarianceBounds) (h_T003 : KdVPlan.FourFrequency) (h_T017 : KdVPlan.MultiplierBound) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ (s : ℝ) (f : KdVPlan.Coeff), 0 ≤ KdVPlan.hn s f" := by
  intro s f
