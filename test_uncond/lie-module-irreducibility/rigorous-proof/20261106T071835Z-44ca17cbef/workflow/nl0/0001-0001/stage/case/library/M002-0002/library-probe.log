BEGIN_SIGNATURE:M002
@LinearIndependent.span_eq_top_of_card_eq_finrank' : ∀ {K : Type u} {V : Type v} [inst : DivisionRing.{u} K] [inst_1 : AddCommGroup.{v} V]
  [inst_2 : _root_.Module.{u, v} K V] {ι : Type u_1} [inst_3 : Fintype.{u_1} ι] [FiniteDimensional.{u, v} K V]
  {b : ι → V},
  LinearIndependent.{u_1, u, v} K b →
    Eq.{1} (Fintype.card.{u_1} ι) (Module.finrank.{u, v} K V) →
      Eq.{v + 1} (Submodule.span.{u, v} K (Set.range.{v, u_1 + 1} b)) Top.top.{v}
BEGIN_AXIOMS:M002
'LinearIndependent.span_eq_top_of_card_eq_finrank'' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
