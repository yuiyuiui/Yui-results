  by_cases hk : |(k:ℝ)| ≤ N
  · simp only [KdVPlan.high,KdVPlan.cutoff,hk,if_true,Pi.sub_apply,sub_self,norm_zero,zero_pow (by decide : 2 ≠ 0),mul_zero,KdVPlan.weight,Real.rpow_zero,one_mul]
