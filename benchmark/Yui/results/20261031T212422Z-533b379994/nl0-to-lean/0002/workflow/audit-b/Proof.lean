theorem yui_aux_0010 (T : ℝ) (gamma : ℝ) (R : ℝ) (h_T013 : KdVPlan.SobolevInfrastructure) : yui_aux_type% "∀ f : KdVPlan.Coeff, Summable (fun k => ‖f k‖) → KdVPlan.LinftyBound f (∑' k, ‖f k‖)" := by
  intro f hf
  have h : ∀ t : ℝ, ‖∑' k : ℤ, f k * Complex.exp (Complex.I * ((k : ℝ)*t : ℝ))‖ ≤ ∑' k, ‖f k‖ := by
   intro t
