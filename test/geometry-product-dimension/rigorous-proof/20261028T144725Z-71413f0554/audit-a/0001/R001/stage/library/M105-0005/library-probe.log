RESOLVED_NAME:M105:ENNReal.lt_iff_exists_real_btwn
RESOLVED_MODULE:M105:Mathlib.Data.ENNReal.Basic
BEGIN_SIGNATURE:M105
@ENNReal.lt_iff_exists_real_btwn : ∀ {a b : ENNReal}, LT.lt.{0} a b ↔ ∃ r, LE.le.{0} 0 r ∧ LT.lt.{0} a (ENNReal.ofReal r) ∧ LT.lt.{0} (ENNReal.ofReal r) b
BEGIN_AXIOMS:M105
'ENNReal.lt_iff_exists_real_btwn' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
