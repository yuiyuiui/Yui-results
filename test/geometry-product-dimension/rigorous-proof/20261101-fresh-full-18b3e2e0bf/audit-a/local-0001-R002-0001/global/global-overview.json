    {
      "pointer": "spec.json#/definitions/5",
      "record": {
        "id": "D006",
        "symbol": "F",
        "type": "subset of ℝ^(n+1)",
        "definition": "F=E×I. The identification (x,t)↦(x_1,…,x_n,t) of ℝ^n×ℝ with ℝ^(n+1) is fixed throughout; dist((x,t),(y,u))=(dist(x,y)^2+|t-u|^2)^(1/2). No maximum product norm is used.",
        "depends_on": [
          "D005"
        ],
