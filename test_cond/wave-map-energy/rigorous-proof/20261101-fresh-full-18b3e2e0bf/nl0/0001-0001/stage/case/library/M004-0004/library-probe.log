BEGIN_SIGNATURE:M004
@exists_hasDerivAt_eq_slope : ∀ (f f' : ℝ → ℝ) {a b : ℝ},
  LT.lt.{0} a b →
    ContinuousOn.{0, 0} f (Set.Icc.{0} a b) →
      (∀ (x : ℝ), Membership.mem.{0, 0} (Set.Ioo.{0} a b) x → HasDerivAt.{0, 0} f (f' x) x) →
        ∃ c,
          Membership.mem.{0, 0} (Set.Ioo.{0} a b) c ∧
            Eq.{1} (f' c) (HDiv.hDiv.{0, 0, 0} (HSub.hSub.{0, 0, 0} (f b) (f a)) (HSub.hSub.{0, 0, 0} b a))
BEGIN_AXIOMS:M004
'exists_hasDerivAt_eq_slope' depends on axioms: [propext, Classical.choice.{u}, Quot.sound.{u}]
