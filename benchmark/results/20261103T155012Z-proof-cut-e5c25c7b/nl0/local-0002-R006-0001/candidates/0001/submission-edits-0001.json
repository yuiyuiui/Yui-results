  "patches": [
    {
      "op": "add",
      "path": "/spec/definitions/-",
      "value": {
        "id": "D020",
        "symbol": "KdV",
        "type": "normalized periodic KdV equation and exact-solution convention",
        "definition": "KdV is the equation u_t+partial_x^3 u=(1/2)*partial_x(u^2) on mathbbT. For a real mean-zero datum q in H^s, s>=0, and horizon A>0, an exact solution u with datum q means the real mean-zero C([0,A];H^s) distributional solution of this equation with u(0)=q obtained by smooth approximation. An exact twisted solution v means v(t)=S_(-t)u(t) for this same equation and interval. A smooth exact solution means such a solution with smooth space and time dependence. These terms specify a solution relation only; existence, uniqueness, bounds and the differential equation for the twist are proved, rather than granted by this definition.",
        "depends_on": [
          "D001",
          "D003",
          "D004"
        ],
        "requires": [],
        "binders": [
          {
            "symbol": "u",
            "type": "periodic time path"
          },
          {
            "symbol": "q",
            "type": "periodic datum"
          },
          {
            "symbol": "s",
            "type": "nonnegative Sobolev exponent"
          },
          {
            "symbol": "A",
            "type": "positive horizon"
          },
          {
            "symbol": "t",
            "type": "time in [0,A]"
          },
          {
            "symbol": "v",
            "type": "twisted time path"
          }
        ],
        "objects": [
          "mathbbT",
          "H",
          "S"
        ]
      }
    },
