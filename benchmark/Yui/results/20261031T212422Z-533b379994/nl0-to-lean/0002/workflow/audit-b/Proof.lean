    exact (hmul k).const_mul (Complex.I*(k:ℂ))
  intro k
  have hh := @yui_aux_0057 T gamma R h_H002 h_T005 h_T006 h_T008 h_T009 h_T013 μ (-1) h k (hmeas k)
