KdV.inclusionMap_val (s r : ℝ) (h : s ≤ r) (f : KdV.Sobolev r) : ((KdV.inclusionMap s r h) f).val = f.val
KdV.inclusionMap (s r : ℝ) (hsr : s ≤ r) : KdV.Sobolev r →L[ℂ] KdV.Sobolev s
@[defeq] theorem KdV.inclusionMap_val : ∀ (s r : ℝ) (h : s ≤ r) (f : KdV.Sobolev r),
  ((KdV.inclusionMap s r h) f).val = f.val :=
fun s r h f => rfl
