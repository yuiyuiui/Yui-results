event: response.function_call_arguments.done
data: {"type":"response.function_call_arguments.done","sequence_number":2222,"item_id":"fc_0c8f582bdc7621f0016ae2187738648191b82dcaa49a504f4f","output_index":1,"arguments":"{\"proof\":\"classical\\nhave sd : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : WSpace n × ℝ → F) (p : WSpace n × ℝ), ContDiffAt ℝ ∞ f p → ContDiffAt ℝ ∞ (wT f) p ∧ ∀ j, ContDiffAt ℝ ∞ (wX f j) p := by\\n  intro F _ _ f p hf\\n  constructor\\n  · have hh : ContDiffAt ℝ ∞ (fun z : (WSpace n × ℝ) × ℝ => f (z.1.1,z.2)) (p,p.2) := hf.comp _ (contDiffAt_fst.fst.prodMk contDiffAt_snd)\\n    exact (hh.fderiv contDiffAt_snd (by simp : (∞ : WithTop ℕ∞) + 1 ≤ ∞)).clm_apply (contDiffAt_const (c := (1 : ℝ)))\\n  · intro j\\n    have hh : ContDiffAt ℝ ∞ (fun z : (WSpace n × ℝ) × WSpace n => f (z.2,z.1.2)) (p,p.1) := hf.comp _ (contDiffAt_snd.prodMk contDiffAt_fst.snd)\\n    exact (hh.fderiv contDiffAt_fst (by simp : (∞ : WithTop ℕ∞) + 1 ≤ ∞)).clm_apply (contDiffAt_const (c := (Pi.single j 1 : WSpace n)))\\nhave zd : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : WSpace n × ℝ → F) (c : F) (O : Set (WSpace n × ℝ)), IsOpen O → (∀ p ∈ O, f p = c) → ∀ p ∈ O, wT f p = 0 ∧ ∀ j, wX f j p = 0 := by\\n  intro F _ _ f c O hO hf p hp\\n  have he : f =ᶠ[nhds p] (fun _ => c) := Filter.eventuallyEq_of_mem (hO.mem_nhds hp) hf\\n  constructor\\n  · have hline : (fun r => f (p.1,r)) =ᶠ[nhds p.2] (fun _ => c) := he.comp_tendsto (continuousAt_const.prodMk continuousAt_id)\\n    change deriv (fun r => f (p.1,r)) p.2 = 0\\n    rw [hline.deriv_eq, deriv_const]\\n  · intro j\\n    have hline : (fun x => f (x,p.2)) =ᶠ[nhds p.1] (fun _ => c) := he.comp_tendsto (continuousAt_id.prodMk continuousAt_const)\\n    change fderiv ℝ (fun x => f (x,p.2)) p.1 (Pi.single j 1) = 0\\n    rw [hline.fderiv_eq, fderiv_const_apply]\\n    rfl\\nhave hDom : IsOpen (wDomain n) := isOpen_lt continuous_const continuous_snd\\nhave su : ∀ p ∈ wDomain n, ContDiffAt ℝ ∞ u p := fun p hp => h_H002.contDiffAt (hDom.mem_nhds hp)\\nhave st : ∀ p ∈ wDomain n, ContDiffAt ℝ ∞ (wT u) p := fun p hp => (sd u p (su p hp)).1\\nhave sx : ∀ j p, p ∈ wDomain n → ContDiffAt ℝ ∞ (wX u j) p := fun j p hp => (sd u p (su p hp)).2 j\\nhave se : ∀ p ∈ wDomain n, ContDiffAt ℝ ∞ (wDensity u) p := by\\n  intro p hp\\n  exact ((st p hp).norm_sq ℝ).add (ContDiffAt.sum (fun j _ => (sx j p hp).norm_sq ℝ))\\nhave set : ∀ p ∈ wDomain n, ContDiffAt ℝ ∞ (wT (wDensity u)) p := fun p hp => (sd _ p (se p hp)).1\\nhave sg : ∀ j p, p ∈ wDomain n → ContDiffAt ℝ ∞ (wG u j) p := fun j p hp => (st p hp).inner ℝ (sx j p hp)\\nintro t ht\\nobtain ⟨C, R, hgeo⟩ := h_T004 t ht\\nhave hC : IsCompact C := hgeo.1\\nlet O : Set (WSpace n × ℝ) := Cᶜ ×ˢ Ioo (t/2) (3*t/2)\\nhave hO : IsOpen O := hC.isClosed.isOpen_compl.prod isOpen_Ioo\\nhave zu : ∀ p ∈ O, u p = q := by\\n  intro p hp\\n  exact hgeo.2.2.2.1 p.1 p.2 hp.1 ⟨hp.2.1.le, hp.2.2.le⟩\\nhave zt : ∀ p ∈ O, wT u p = 0 := fun p hp => (zd u q O hO zu p hp).1\\nhave zx : ∀ j p, p ∈ O → wX u j p = 0 := fun j p hp => (zd u q O hO zu p hp).2 j\\nhave ze : ∀ p ∈ O, wDensity u p = 0 := by\\n  intro p hp\\n  simp [wDensity, zt p hp, fun j => zx j p hp]\\nhave zet : ∀ p ∈ O, wT (wDensity u) p = 0 := fun p hp => (zd _ 0 O hO ze p hp).1\\nhave zg : ∀ j p, p ∈ O → wG u j p = 0 := by\\n  intro j p hp\\n  simp [wG, zt p hp]\\nhave zxg : ∀ j p, p ∈ O → wX (wG u j) j p = 0 := fun j p hp => (zd _ 0 O hO (zg j) p hp).2 j\\nhave nice : ∀ (f : WSpace n × ℝ → ℝ), (∀ p ∈ wDomain n, ContDiffAt ℝ ∞ f p) → (∀ p ∈ O, f p = 0) → ∀ r ∈ Ioo (t/2) (3*t/2), wNice C (fun x => f (x,r)) := by\\n  intro f hs hz r hr\\n  have hr0 : 0 < r := by linarith [hr.1]\\n  have hc : Continuous (fun x : WSpace n => f (x,r)) := by\\n    apply continuous_iff_continuousAt.mpr\\n    intro x\\n    exact ContinuousAt.comp (f := fun y : WSpace n => (y,r)) (hs (x,r) hr0).continuousAt (continuousAt_id.prodMk continuousAt_const)\\n  have hzero : ∀ x, x ∉ C → f (x,r) = 0 := fun x hx => hz (x,r) ⟨hx,hr⟩\\n  refine ⟨hc, hzero, hc.integrable_of_hasCompactSupport ?_⟩\\n  apply HasCompactSupport.of_support_subset_isCompact hC\\n  intro x hx\\n  by_contra hn\\n  exact hx (hzero x hn)\\nhave hn : ∀ r ∈ Ioo (t/2) (3*t/2), ∀ f ∈ wTerms u r, wNice C f := by\\n  intro r hr f hf\\n  rcases hf with h | h | h | ⟨j, h | h | h | h⟩\\n  · subst f; exact nice _ se ze r hr\\n  · subst f; exact nice _ set zet r hr\\n  · subst f\\n    apply nice _ (fun p hp => (st p hp).inner ℝ ((sd _ p (st p hp)).1)) ?_ r hr\\n    intro p hp\\n    simp [wA, zt p hp]\\n  · subst f\\n    apply nice _ (fun p hp => (sx j p hp).inner ℝ ((sd _ p (st p hp)).2 j)) ?_ r hr\\n    intro p hp\\n    simp [wB, zx j p hp]\\n  · subst f\\n    apply nice _ (fun p hp => (st p hp).inner ℝ ((sd _ p (sx j p hp)).2 j)) ?_ r hr\\n    intro p hp\\n    simp [wC, zt p hp]\\n  · subst f; exact nice _ (sg j) (zg j) r hr\\n  · subst f\\n    exact nice _ (fun p hp => (sd _ p (sg j p hp)).2 j) (zxg j) r hr\\nhave hti : t ∈ Ioo (t/2) (3*t/2) := by constructor <;> linarith\\nhave hi : Integrable (fun x : WSpace n => wDensity u (x,t)) := (nice _ se ze t hti).2.2\\nhave hk : IsCompact (wBox n R ×ˢ Icc (3*t/4) (5*t/4)) := isCompact_Icc.prod isCompact_Icc\\nhave hcont : ContinuousOn (wT (wDensity u)) (wBox n R ×ˢ Icc (3*t/4) (5*t/4)) := by\\n  intro p hp\\n  apply (set p ?_).continuousAt.continuousWithinAt\\n  change 0 < p.2\\n  linarith [hp.2.1]\\nobtain ⟨B0, hB0⟩ := hk.exists_bound_of_continuousOn hcont\\nrefine ⟨hi, C, R, max 0 B0, hgeo, le_max_left _ _, hn, ?_⟩\\nintro x hx r hr\\nhave hb : |wT (wDensity u) (x,r)| ≤ B0 := by simpa only [Real.norm_eq_abs] using hB0 (x,r) ⟨hx,hr⟩\\nexact hb.trans (le_max_right _ _)\"}"}

event: response.output_item.done
data: {"type":"response.output_item.done","sequence_number":2223,"output_index":1,"item":{"type":"function_call","id":"fc_0c8f582bdc7621f0016ae2187738648191b82dcaa49a504f4f","call_id":"call_89d6497308bf417f8d997ccede8703f7","name":"submit_transition","arguments":"{\"proof\":\"classical\\nhave sd : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : WSpace n × ℝ → F) (p : WSpace n × ℝ), ContDiffAt ℝ ∞ f p → ContDiffAt ℝ ∞ (wT f) p ∧ ∀ j, ContDiffAt ℝ ∞ (wX f j) p := by\\n  intro F _ _ f p hf\\n  constructor\\n  · have hh : ContDiffAt ℝ ∞ (fun z : (WSpace n × ℝ) × ℝ => f (z.1.1,z.2)) (p,p.2) := hf.comp _ (contDiffAt_fst.fst.prodMk contDiffAt_snd)\\n    exact (hh.fderiv contDiffAt_snd (by simp : (∞ : WithTop ℕ∞) + 1 ≤ ∞)).clm_apply (contDiffAt_const (c := (1 : ℝ)))\\n  · intro j\\n    have hh : ContDiffAt ℝ ∞ (fun z : (WSpace n × ℝ) × WSpace n => f (z.2,z.1.2)) (p,p.1) := hf.comp _ (contDiffAt_snd.prodMk contDiffAt_fst.snd)\\n    exact (hh.fderiv contDiffAt_fst (by simp : (∞ : WithTop ℕ∞) + 1 ≤ ∞)).clm_apply (contDiffAt_const (c := (Pi.single j 1 : WSpace n)))\\nhave zd : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (f : WSpace n × ℝ → F) (c : F) (O : Set (WSpace n × ℝ)), IsOpen O → (∀ p ∈ O, f p = c) → ∀ p ∈ O, wT f p = 0 ∧ ∀ j, wX f j p = 0 := by\\n  intro F _ _ f c O hO hf p hp\\n  have he : f =ᶠ[nhds p] (fun _ => c) := Filter.eventuallyEq_of_mem (hO.mem_nhds hp) hf\\n  constructor\\n  · have hline : (fun r => f (p.1,r)) =ᶠ[nhds p.2] (fun _ => c) := he.comp_tendsto (continuousAt_const.prodMk continuousAt_id)\\n    change deriv (fun r => f (p.1,r)) p.2 = 0\\n    rw [hline.deriv_eq, deriv_const]\\n  · intro j\\n    have hline : (fun x => f (x,p.2)) =ᶠ[nhds p.1] (fun _ => c) := he.comp_tendsto (continuousAt_id.prodMk continuousAt_const)\\n    change fderiv ℝ (fun x => f (x,p.2)) p.1 (Pi.single j 1) = 0\\n    rw [hline.fderiv_eq, fderiv_const_apply]\\n    rfl\\nhave hDom : IsOpen (wDomain n) := isOpen_lt continuous_const continuous_snd\\nhave su : ∀ p ∈ wDomain n, ContDiffAt ℝ ∞ u p := fun p hp => h_H002.contDiffAt (hDom.mem_nhds hp)\\nhave st : ∀ p ∈ wDomain n, ContDiffAt ℝ ∞ (wT u) p := fun p hp => (sd u p (su p hp)).1\\nhave sx : ∀ j p, p ∈ wDomain n → ContDiffAt ℝ ∞ (wX u j) p := fun j p hp => (sd u p (su p hp)).2 j\\nhave se : ∀ p ∈ wDomain n, ContDiffAt ℝ ∞ (wDensity u) p := by\\n  intro p hp\\n  exact ((st p hp).norm_sq ℝ).add (ContDiffAt.sum (fun j _ => (sx j p hp).norm_sq ℝ))\\nhave set : ∀ p ∈ wDomain n, ContDiffAt ℝ ∞ (wT (wDensity u)) p := fun p hp => (sd _ p (se p hp)).1\\nhave sg : ∀ j p, p ∈ wDomain n → ContDiffAt ℝ ∞ (wG u j) p := fun j p hp => (st p hp).inner ℝ (sx j p hp)\\nintro t ht\\nobtain ⟨C, R, hgeo⟩ := h_T004 t ht\\nhave hC : IsCompact C := hgeo.1\\nlet O : Set (WSpace n × ℝ) := Cᶜ ×ˢ Ioo (t/2) (3*t/2)\\nhave hO : IsOpen O := hC.isClosed.isOpen_compl.prod isOpen_Ioo\\nhave zu : ∀ p ∈ O, u p = q := by\\n  intro p hp\\n  exact hgeo.2.2.2.1 p.1 p.2 hp.1 ⟨hp.2.1.le, hp.2.2.le⟩\\nhave zt : ∀ p ∈ O, wT u p = 0 := fun p hp => (zd u q O hO zu p hp).1\\nhave zx : ∀ j p, p ∈ O → wX u j p = 0 := fun j p hp => (zd u q O hO zu p hp).2 j\\nhave ze : ∀ p ∈ O, wDensity u p = 0 := by\\n  intro p hp\\n  simp [wDensity, zt p hp, fun j => zx j p hp]\\nhave zet : ∀ p ∈ O, wT (wDensity u) p = 0 := fun p hp => (zd _ 0 O hO ze p hp).1\\nhave zg : ∀ j p, p ∈ O → wG u j p = 0 := by\\n  intro j p hp\\n  simp [wG, zt p hp]\\nhave zxg : ∀ j p, p ∈ O → wX (wG u j) j p = 0 := fun j p hp => (zd _ 0 O hO (zg j) p hp).2 j\\nhave nice : ∀ (f : WSpace n × ℝ → ℝ), (∀ p ∈ wDomain n, ContDiffAt ℝ ∞ f p) → (∀ p ∈ O, f p = 0) → ∀ r ∈ Ioo (t/2) (3*t/2), wNice C (fun x => f (x,r)) := by\\n  intro f hs hz r hr\\n  have hr0 : 0 < r := by linarith [hr.1]\\n  have hc : Continuous (fun x : WSpace n => f (x,r)) := by\\n    apply continuous_iff_continuousAt.mpr\\n    intro x\\n    exact ContinuousAt.comp (f := fun y : WSpace n => (y,r)) (hs (x,r) hr0).continuousAt (continuousAt_id.prodMk continuousAt_const)\\n  have hzero : ∀ x, x ∉ C → f (x,r) = 0 := fun x hx => hz (x,r) ⟨hx,hr⟩\\n  refine ⟨hc, hzero, hc.integrable_of_hasCompactSupport ?_⟩\\n  apply HasCompactSupport.of_support_subset_isCompact hC\\n  intro x hx\\n  by_contra hn\\n  exact hx (hzero x hn)\\nhave hn : ∀ r ∈ Ioo (t/2) (3*t/2), ∀ f ∈ wTerms u r, wNice C f := by\\n  intro r hr f hf\\n  rcases hf with h | h | h | ⟨j, h | h | h | h⟩\\n  · subst f; exact nice _ se ze r hr\\n  · subst f; exact nice _ set zet r hr\\n  · subst f\\n    apply nice _ (fun p hp => (st p hp).inner ℝ ((sd _ p (st p hp)).1)) ?_ r hr\\n    intro p hp\\n    simp [wA, zt p hp]\\n  · subst f\\n    apply nice _ (fun p hp => (sx j p hp).inner ℝ ((sd _ p (st p hp)).2 j)) ?_ r hr\\n    intro p hp\\n    simp [wB, zx j p hp]\\n  · subst f\\n    apply nice _ (fun p hp => (st p hp).inner ℝ ((sd _ p (sx j p hp)).2 j)) ?_ r hr\\n    intro p hp\\n    simp [wC, zt p hp]\\n  · subst f; exact nice _ (sg j) (zg j) r hr\\n  · subst f\\n    exact nice _ (fun p hp => (sd _ p (sg j p hp)).2 j) (zxg j) r hr\\nhave hti : t ∈ Ioo (t/2) (3*t/2) := by constructor <;> linarith\\nhave hi : Integrable (fun x : WSpace n => wDensity u (x,t)) := (nice _ se ze t hti).2.2\\nhave hk : IsCompact (wBox n R ×ˢ Icc (3*t/4) (5*t/4)) := isCompact_Icc.prod isCompact_Icc\\nhave hcont : ContinuousOn (wT (wDensity u)) (wBox n R ×ˢ Icc (3*t/4) (5*t/4)) := by\\n  intro p hp\\n  apply (set p ?_).continuousAt.continuousWithinAt\\n  change 0 < p.2\\n  linarith [hp.2.1]\\nobtain ⟨B0, hB0⟩ := hk.exists_bound_of_continuousOn hcont\\nrefine ⟨hi, C, R, max 0 B0, hgeo, le_max_left _ _, hn, ?_⟩\\nintro x hx r hr\\nhave hb : |wT (wDensity u) (x,r)| ≤ B0 := by simpa only [Real.norm_eq_abs] using hB0 (x,r) ⟨hx,hr⟩\\nexact hb.trans (le_max_right _ _)\"}","status":"completed"}}

event: response.metadata
data: {"type":"response.metadata","sequence_number":2224,"response_id":"resp_0c8f582bdc7621f0016ae21873e1288191b03e71b96cc434f1","metadata":{"openai_chatgpt_moderation_metadata":{"prompt":{"omnimod":{"protection_type":"omnimod","outputs":[{"results":[{"category_flags":{"A1":false,"A2":false,"A3":false,"C1":false,"C11":false,"C2":false,"E1":false,"E2":false,"E3":false,"H1":false,"H2":false,"H3":false,"JB1":false,"K1":false,"K2":false,"K3":false,"K4":false,"P1":false,"P2":false,"P3":false,"P4":false,"PD1":false,"PD4":false,"S1":false,"S3+":false,"S4":false,"SH":false,"TXT-C3":false,"TXT-C4":false,"V1":false,"V2+":false,"V4+":false,"REFUSED":false,"CBRN-B1+":false,"IMG-C1":false,"IMG-C11":false,"IMG-C2":false,"IMG-S1":false,"IMG-SH":false,"IMG-V1":false,"IMG-V2+":false,"IMG-V4+":false}}],"is_blocked":false}]}},"generation":{},"tool_call":{},"tool_response":{}}}}

event: response.completed
data: {"type":"response.completed","sequence_number":2225,"safety_buffering":false,"response":{"id":"resp_0c8f582bdc7621f0016ae21873e1288191b03e71b96cc434f1","object":"response","created_at":1793202292,"completed_at":1793202314,"status":"completed","background":false,"frequency_penalty":0.0,"presence_penalty":0.0,"moderation":null,"model":"gpt-6.1-sol","access_programs":{"cyber":"standard"},"previous_response_id":null,"instructions":"You translate the supplied natural-language proof faithfully into Lean 4. Use the explicit project premises and any proved result in the pinned Mathlib environment. Preserve all assumptions, conclusions, equality modes and the supplied proof route. No reference answers, personal context, other tasks, shell or external services are available. Use the submit tool when the requested artifact is complete; if rejected, repair it. A strategy is advice, never an additional theorem or assumption.\n\n# Lean implementation safeguards\n\nApply these requirements within the accepted NL0 and the fixed Lean interface.\nThey govern implementation, not additional NL0 detail or a weaker Audit B.\nUse existing library readers and local checking tools; no separate review\nmodel, new premise or mandatory lookup of every familiar declaration is needed.\n\n1. **Check critical library signatures.** Before relying on a critical or\n   unfamiliar library application, establish its complete type in the pinned\n   environment, including explicit, implicit and instance binders and all\n   side conditions. Read the declaration or check a small typed application\n   when its signature is uncertain. Do not infer the calling convention from\n   its name or pass an implicit argument as though it were an explicit one.\n   A previously checked signature in this context need not be looked up again.\n2. **Constrain difficult inference.** When coercions or implicit inference\n   obscure the intended application, give the intermediate fact an explicit\n   type and supply the relevant named parameters, such as the set, exponent\n   or ambient space. Prefer this to leaving Lean to discover those choices by\n   unfolding large definitions. Routine unambiguous arguments can stay\n   implicit; explicit parameters must preserve the existing target and inputs.\n3. **Check conversions before combining them.** When an argument crosses Lean\n   representations, first establish a small typed conversion fact, then use\n   it in the main proof. In particular, distinguish `ℝ`, `ℝ≥0` and `ℝ≥0∞`;\n   check the conversion direction, nonnegativity and any finiteness conditions.\n   A conversion is not automatically invertible, and matching notation does\n   not establish equality of differently typed expressions. Reuse a checked\n   fact when available. Do not invent another representation, a global helper\n   requirement or an extra hypothesis just to satisfy this instruction.\n4. **Isolate an inference failure.** If compiler feedback identifies a library\n   application, coercion or expensive inference problem, reduce the next check\n   to that application or conversion with explicit local types before adding\n   more proof code. Use `check_auxiliary` in a proof worker, or\n   `check_lean_types` during preparation when that tool is supplied. Helpers\n   use only the current allowed inputs and never become new premises. Once\n   the small check succeeds, integrate the result and recheck the complete\n   obligation; success of a helper alone does not accept the target.\n\nThese rules do not interrupt an active compiler call or impose a time limit.\nThey guide the next implementation/checking action when feedback is available.\nRetain failed attempts and actual diagnostics. Standalone assembly, native\ntrust/signature checks and independent endpoint-fidelity Audit B remain required.\n End this stage immediately when a submit tool reports stage_complete:true; the controller handles later stages. Within a proof stage, checked helper attempts are available through read_lean_draft. After a context reset, query its index before claiming no draft or helper exists. Helpers never become new premises. Use familiar interfaces directly; no background-note scan is required. For a relevant obstacle, select a matching local background_note_index entry and read_background_note if its details may help. Relate the actual Lean goal/context to its NL step: use the note grounds to identify a small missing application premise or transport, prove it from permitted inputs, then check the intended application. Verify actual types and conditions; a note is not a Lean proof or extra assumption. If it does not fit, continue ordinary allowed search or repair without insisting on that note or rebuilding a larger argument by default.","output":[{"type":"reasoning","id":"rs_0c8f582bdc7621f0016ae2187715a8819194dc4136c43faf7e","summary":[],"content":[],"encrypted_content":"gAAAAABq4hh3GjaskuC1zdK-FJI5e5VKtWbbsq7gEfr-1kJw5Mw5fGlze_Hdo-cjOkzSgOcrq42OM4eH4XXTmWa_FpIUztfkLbBfs_S5Pisr0h3zeA7AZSTnlWDwglQqL4VCgNZODhaQM8c4YpEZqceMUCWAN9oWXWqAbCnMsCoIB00qlf18z9pzbIhs1ZhuL2uO_vDKDxxkqXcq24vO4RHvbWrEBNihxVOEJJDhW8fNYWwi0L615gBzq8OONWT9piKQxDuLXFLnpX7XG1LX0Ewd7O4SltK4BMyE7c7uoFI9h9kspwZpDKqwKJ8y5swxC3ynSZuI6GRYQTrEYjqE6-W4A-RTfjOIkd-b3Bk63-bggk_7sk4s5cGkpvEaVuaSQLw5yWBR6m1GlgLSpMh0eM9pPUl1ZYQYuV9Efhg_rDB9difNA-wxapeKyZLsbChusVYtJMt4D44QSSIZPue78r9qAuKQQuMpHf-tkqrSAzQgS-H8UfmnsLXyuUf4ReoW902HE6OYSMixt5ZJzAat10x6KuPmNaWoILyZ95fFd9JAy-CMKddIMwwRaB5xc4ml4xyKegMDkyW4g3Nx4JWYgr8bmmT6LOPLkBet81TCZ11rjyYYMLjIBeNcBy1_VMSry2usRcndicQSINB5OvXeTStLy2PqDUIcSguAkzmj9LxtvUPbvgbPXYAydu24m0ciO9PPjvycYG-AUmRl-aHGzGfEIGlwSzusC0VipxxiYvBdcShB-a6QKNcCiLFL_0N54XIkBmhctvSmUqrttXTcr74mJCRkxvcYrJq0wp2zhJ-uUqocerE9ImjOk_TiOnqUq5hmaencrhUeTEXFJI3Ey4dgXiUTCamE9Ab-hvJ5s2uZ-vLA-PH0rB_jKh9_dMAAcJH6phD4h85TS4sy3g7UgeHepjJpjCvgd7nDFsxAJiaF-EMLb6-NMhaurDiagQSJaX5WbPWx5Aqs-ZbgdeUl4Kbhpz4Cay_4Nm0NTeqnT5IJwuK0z-BIwtL3NFG38TgNshaktlPfyojKkdXbE1jklbrKnngAuzFfre4EcR01S4nPDo-KGaxGfAdiGAFQrNkw_Z6F6oz